#!/usr/bin/env python3
"""kbuild-pool: resource-aware parallel builds of a prepared kbuild-run.

  kbuild-pool --list <ship.list|file> [--waves 0,A] [--standin 0|1] [--publish] [--run-id ID] [--dry-run]

The list holds one pkgbase per line, optionally `pkgbase<TAB>wave` (kashira-pkgs ship/ship.list); --waves selects
lines by wave. The pool runs `kbuild-run prepare`, builds every target with `kbuild-run one`, then `kbuild-run finish`.

Scheduling (no level barriers): a target is ready once each in-run dependency has finished, successfully or not
(stand-ins satisfy failed or not-yet-built deps; with --standin 0 a failed dep fails its dependents). Cycles are cut
with kbuild-sched's feedback-edge ordering. Ready targets start by wave, then critical-path length, then duration,
while CPU and memory budgets allow; a heavy target at the head of the queue reserves the machine until it fits.

Each class requests CPUs (a disjoint --cpuset-cpus range, so nproc follows), memory and a timeout:
small 1/4G/2h, medium 4/8G/4h, large 8/14G/8h, heavy 8/14G/20h (swap mem+12G; two fit side by side). Retries:
oom -> once one class up; a compile error is final (fail:build: the fix goes into the PKGBUILD);
source and deps failures are final. Results: build/logs/pool/<run>/status.tsv, pool.log, summary.txt.
"""
import fcntl
import importlib.util
import json
import os
import re
import signal
import subprocess
import sys
import tarfile
import time

HERE = os.path.dirname(os.path.realpath(__file__))
PKGS = os.environ.get("KBUILD_PKGS") or os.path.join(HERE, "..", "kashira-pkgs")
ROOT = os.environ.get("KASHIRA_ROOT", "/mnt/kashira")
LOGS = os.environ.get("KBUILD_LOGS") or os.path.join(ROOT, "build/logs")
OUT = os.environ.get("KBUILD_OUT") or os.path.join(ROOT, "build/out")

CPU_BUDGET = int(os.environ.get("KBUILD_POOL_CPUS", "16"))
MEM_BUDGET = int(os.environ.get("KBUILD_POOL_MEM_GIB", "28"))
CLASSES = ["small", "medium", "large", "heavy"]
SPEC = {  # cpus, memory GiB, timeout hours
    "small": (1, 4, 2), "medium": (4, 8, 4), "large": (8, 14, 8), "heavy": (8, 14, 20),  # not exclusive: gcc/llvm have long serial phases, a lone -j16 heavy idled half the CPUs
}
HEAVY = {"llvm", "gcc", "rust", "linux", "firefox", "thunderbird", "libreoffice-fresh", "electron", "qt6-webengine",
         "webkit2gtk-4.1", "webkitgtk-6.0", "wpewebkit", "nodejs", "ghc", "java-openjdk", "java21-openjdk", "kicad",
         "blender", "texlive-bin"}
WAVE_ORDER = {"0": 0, "A": 1, "B": 2, "C": 3, "D": 4}
UNKNOWN_DURATION = 60
MAX_SHARED = 8
MAX_REUSE = 12        # concurrent reuse-only jobs (I/O: repo db scans)

FAIL = [  # (kind, regex) checked in order on the log tail
    ("post", re.compile(r"==> Finished making: ")),  # makepkg succeeded; kbuild's artifact/repo checks did not
    ("source", re.compile(r"Failure while downloading|could not resolve|returned error: [45]|One or more files did not pass the validity check")),
    # a package rebuilt at the same version was repo-added while this container installed from the older db
    ("transient", re.compile(r"failed retrieving file .* from disk|download library error|is corrupted \(invalid or corrupted package \(checksum\)\)")),
    ("deps", re.compile(r"unable to satisfy dependency|target not found|conflicting files|failed to commit transaction|"
                        r"could not satisfy dependencies|conflicting dependencies|unresolvable package conflicts")),
    ("oom", re.compile(r"\bKilled\b|signal 9|signal: 9, SIGKILL|Cannot allocate memory|std::bad_alloc|out of memory")),
]

PACMAN_FAIL = re.compile(r"failed to commit transaction|could not satisfy dependencies")


def reserve_of(cls, mem):
    """Memory the budget counts for a job; the container limit stays mem."""
    return mem // 2 if cls == "small" else mem


def classify(rc, tail):
    """post | source | deps | oom | build for a failed attempt (rc != 0)."""
    if rc in (137, -9):
        return "oom"
    for kind, rx in FAIL:
        if rx.search(tail):
            return kind
    return "build"


def first_error(tail):
    for line in tail.splitlines():
        if re.search(r"\berror:", line) and "resolv.conf" not in line:  # docker-mounted resolv.conf: harmless
            return line.strip()[:300]
    return ""


def load_sched():
    spec = importlib.util.spec_from_file_location("kbuild_sched", os.path.join(HERE, "kbuild-sched.py"))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def cut_cycles(deps):
    """deps: {node: set(in-run deps)} -> a copy with feedback edges removed (acyclic)."""
    sched = load_sched()
    live = {n: set(ds) for n, ds in deps.items()}
    for comp in sched._sccs(live):
        for n, d in sched._feedback_edges(comp, live, {}):
            live[n].discard(d)
    return live


def critical_path(deps, duration):
    """Longest chain of dependents starting at each node (its own duration included)."""
    users = {n: set() for n in deps}
    for n, ds in deps.items():
        for d in ds:
            users[d].add(n)
    memo = {}
    for start in deps:
        stack = [(start, False)]
        while stack:
            n, done = stack.pop()
            if n in memo:
                continue
            if done:
                memo[n] = duration(n) + max((memo[u] for u in users[n]), default=0)
                continue
            stack.append((n, True))
            stack.extend((u, False) for u in users[n] if u not in memo)
    return memo


class Job:
    def __init__(self, name, cls, wave, knobs):
        self.name, self.cls, self.wave, self.knobs = name, cls, wave, knobs
        self.tier = 0            # kept for status.tsv; toolchain and flags come from the PKGBUILD only
        self.oom_retried = False
        self.transient_retries = 0
        self.tier0_error = ""
        self.cpus = []
        self.t0 = 0.0
        self.shared = False      # a small job placed on a busy job's CPU while the host idled
        self.reuse = False       # KBUILD_REUSE=recipe and its recorded recipe still matches: no build, no budget
        self.mem = 0             # granted at admit: the class memory, or the whole budget when alone
        self.reserve = 0         # what the budget counts: half the limit for small jobs, which rarely use 1 GiB

    def spec(self):
        cpus, mem, hours = SPEC[self.cls]
        for k in self.knobs:
            if k.startswith("mem="):
                mem = int(k[4:-1])
            elif k.startswith("timeout="):
                hours = int(k[8:-1])
        return cpus, mem, hours

    def jobs(self):
        return next((int(k[5:]) for k in self.knobs if k.startswith("jobs=")), len(self.cpus) or SPEC[self.cls][0])


class Pool:
    """The scheduler core. runner: start(job) and wait() -> [(job, rc, log tail, seconds)]."""

    def __init__(self, jobs, deps, duration, runner, standin=True, log=print):
        self.jobs = {j.name: j for j in jobs}
        self.deps = cut_cycles({n: {d for d in deps.get(n, ()) if d in self.jobs and d != n} for n in self.jobs})
        self.duration = duration
        self.cp = critical_path(self.deps, duration)
        self.runner, self.standin, self.log = runner, standin, log
        self.pending = set(self.jobs)
        self.running = {}
        self.finished = {}       # name -> result: built | fail:<kind>
        self.free_cpus = list(range(CPU_BUDGET))
        self.mem_used = 0
        self.history = []        # (event, name, class, tier, cpus) for tests and --dry-run
        self.prebuilt = set()    # KBUILD_REUSE=recipe: deps with a published earlier build; they do not gate

    def ready(self):
        out = []
        for n in self.pending:
            ds = self.deps[n]
            # a reuse job only re-validates a recorded artifact: its dependencies need not be done
            if self.jobs[n].reuse or all(d in self.finished or d in self.prebuilt for d in ds):
                out.append(n)
        return sorted(out, key=lambda n: (WAVE_ORDER.get(self.jobs[n].wave, 5), -self.cp[n], -self.duration(n), n))

    def fits(self, job):
        cpus, mem, _ = job.spec()
        return len(self.free_cpus) >= cpus and self.mem_used + reserve_of(job.cls, mem) <= MEM_BUDGET

    def shadow_time(self, job):
        """(time, spare CPUs, spare GiB): when the running jobs (by expected end) will have freed enough for job,
        and what is left over then, which jobs of any length may use."""
        cpus, mem, _ = job.spec()
        now = self.runner.clock()
        free, mem_free = len(self.free_cpus), MEM_BUDGET - self.mem_used
        mem = reserve_of(job.cls, mem)
        for j in sorted(self.running.values(), key=lambda j: j.t0 + self.duration(j.name)):
            free, mem_free = free + len(j.cpus), mem_free + j.reserve
            if free >= cpus and mem_free >= mem:
                # an overrunning job: assume it ends soon. The rest of that time's resources is spare.
                return max(j.t0 + self.duration(j.name), now + 60), free - cpus, mem_free - mem
        return now, 0, 0

    def admit(self):
        shadow = None    # a heavy head that does not fit reserves the machine from this time on
        for n in self.ready():
            job = self.jobs[n]
            if not self.standin and any(self.finished.get(d, "built") != "built" for d in self.deps[n]):
                self.pending.discard(n)
                self.finished[n] = "fail:dep"
                self.history.append(("skip", n, job.cls, job.tier, 0))
                continue
            if job.reuse and sum(j.reuse for j in self.running.values()) < MAX_REUSE:
                self.start_reuse(job)
                continue
            if not self.fits(job) and job.cls == "small" and self.share(job):
                continue
            if not self.fits(job):
                if job.cls == "heavy" and shadow is None:
                    shadow, spare_cpus, spare_mem = self.shadow_time(job)
                continue
            if shadow is not None and self.runner.clock() + self.duration(n) > shadow:
                # backfill only what ends before the reserved heavy can start, or fits in what it leaves spare
                c, m, _ = job.spec()
                m = reserve_of(job.cls, m)
                if c > spare_cpus or m > spare_mem:
                    continue
                spare_cpus, spare_mem = spare_cpus - c, spare_mem - m
            cpus, mem, _ = job.spec()
            if not self.running and len(self.ready()) == 1 and self.gates_all(n):
                # alone, and every other pending job waits on it (a chain like glibc -> gcc -> llvm): take the whole
                # machine. Not when others are merely not ready yet: electron44 held all 16 CPUs for hours that way.
                cpus, mem = CPU_BUDGET, max(mem, MEM_BUDGET)
            job.cpus = self.free_cpus[:min(cpus, CPU_BUDGET)]
            self.free_cpus = self.free_cpus[len(job.cpus):]
            job.mem = mem
            job.reserve = reserve_of(job.cls, mem) if self.running or len(self.ready()) > 1 else mem
            job.t0 = self.runner.clock()
            self.mem_used += job.reserve
            self.pending.discard(n)
            self.running[n] = job
            self.history.append(("start", n, job.cls, job.tier, len(job.cpus)))
            self.runner.start(job)

    def gates_all(self, n):
        """Every other pending job depends on n, directly or through other pending jobs."""
        rdeps = {}
        for m in self.pending:
            for d in self.deps[m]:
                rdeps.setdefault(d, set()).add(m)
        seen, todo = set(), [n]
        while todo:
            for m in rdeps.get(todo.pop(), ()):
                if m not in seen:
                    seen.add(m)
                    todo.append(m)
        return self.pending - {n} <= seen

    def share(self, job):
        """Start a small job on the CPU of a running job when the host measures idle (reservations are upper
        bounds: ghc holding 8 CPUs and 14 GiB through a serial phase idled 60% of the machine). Its container keeps
        its own limit; at most MAX_SHARED run this way."""
        if sum(j.shared for j in self.running.values()) >= MAX_SHARED or not self.runner.spare():
            return False
        load = {c: 0 for c in range(CPU_BUDGET)}
        for j in self.running.values():
            for c in j.cpus:
                load[c] += 1
        job.cpus, job.shared = [min(load, key=lambda c: (load[c], c))], True
        job.mem = job.spec()[1]
        job.reserve, job.t0 = 0, self.runner.clock()
        self.pending.discard(job.name)
        self.running[job.name] = job
        self.history.append(("start", job.name, job.cls, job.tier, 1))
        self.runner.start(job)
        return True

    def start_reuse(self, job):
        """A job whose recorded build kbuild-run will only re-validate and re-add (seconds, no container) runs
        outside the CPU/memory budget: otherwise a heavy build holding the machine serialises thousands of them."""
        job.reuse = True
        job.cpus = []            # no cpuset: nothing to pin (a hint kbuild-run rejects builds unpinned)
        job.mem, job.reserve, job.t0 = job.spec()[1], 0, self.runner.clock()
        self.pending.discard(job.name)
        self.running[job.name] = job
        self.history.append(("start", job.name, job.cls, job.tier, 0))
        self.runner.start(job)

    def release(self, job):
        if job.reuse and not job.cpus:
            del self.running[job.name]
            return
        if job.shared:
            job.cpus, job.shared = [], False
            del self.running[job.name]
            return
        self.free_cpus = sorted(self.free_cpus + job.cpus)
        self.mem_used -= job.reserve
        job.cpus = []
        del self.running[job.name]

    def complete(self, job, rc, tail, seconds):
        self.release(job)
        if rc == 0:
            self.finished[job.name] = "built"
            self.history.append(("built", job.name, job.cls, job.tier, 0))
            self.on_success(job, seconds)
            return
        kind = classify(rc, tail)
        if job.tier == 0 and not job.tier0_error:
            job.tier0_error = first_error(tail)
        retry = None
        if kind == "oom" and not job.oom_retried:
            job.oom_retried = True
            if job.cls == "heavy":   # no class above: take the memory a lone heavy used to get
                job.knobs = [k for k in job.knobs if not k.startswith("mem=")] + ["mem=20G"]
            else:
                job.cls = CLASSES[CLASSES.index(job.cls) + 1]
            retry = "class " + job.cls + (" mem=20G" if job.cls == "heavy" else "")
        elif kind == "transient" and job.transient_retries < 2:
            job.transient_retries += 1
            retry = f"tier {job.tier} again"
        if retry:
            self.log(f"retry {job.name}: {kind} -> {retry}")
            self.history.append(("retry", job.name, job.cls, job.tier, 0))
            self.pending.add(job.name)
        else:
            self.finished[job.name] = "fail:" + kind
            self.history.append(("fail", job.name, job.cls, job.tier, 0))
            self.on_failure(job, kind)

    def on_success(self, job, seconds):
        pass

    def on_failure(self, job, kind):
        pass

    def requeue(self, names, tune):
        """Build failed targets again (a fix landed), with the current build.tune resource hints."""
        for n in names:
            if not self.finished.get(n, "built").startswith("fail:"):
                continue
            old = self.jobs[n]
            knobs = tune.get(n, [])
            cls = next((k[6:] for k in knobs if k.startswith("class=")), old.cls)
            job = Job(n, cls, old.wave, knobs)
            self.jobs[n] = job
            del self.finished[n]
            self.pending.add(n)
            self.log(f"requeue {n}" + (f" (knobs {','.join(knobs)})" if knobs else ""))

    def poll_requeue(self):
        pass

    def run(self):
        while self.pending or self.running:
            self.poll_requeue()
            self.admit()
            if not self.running:
                if self.pending:     # nothing can start: a dependency is unreachable (must not happen after cuts)
                    for n in sorted(self.pending):
                        self.finished[n] = "fail:unschedulable"
                    self.pending.clear()
                break
            for job, rc, tail, seconds in self.runner.wait():
                self.complete(job, rc, tail, seconds)
        return self.finished


class SimRunner:
    """Virtual-clock runner: every job takes its known duration and succeeds (--dry-run, tests)."""

    def __init__(self, duration, outcome=None):
        self.duration, self.outcome, self.now, self.ends = duration, outcome or (lambda job: (0, "")), 0.0, {}

    def clock(self):
        return self.now

    def spare(self):
        return False

    def start(self, job):
        self.ends[job.name] = (self.now + self.duration(job.name), job)

    def wait(self):
        t = min(e for e, _ in self.ends.values())
        self.now = t
        done = [(n, j) for n, (e, j) in self.ends.items() if e == t]
        out = []
        for n, j in done:
            del self.ends[n]
            rc, tail = self.outcome(j)
            out.append((j, rc, tail, self.duration(n)))
        return out


class DockerRunner:
    """Runs `kbuild-run one` per job; kills the container on timeout."""

    def __init__(self, run_id, run_dir):
        self.run_id, self.run_dir, self.procs = run_id, run_dir, {}
        self.idle, self.stat, self.woke = 0.0, None, 0.0

    def sample(self):
        """Smoothed host idle fraction from /proc/stat."""
        v = [int(x) for x in open("/proc/stat").readline().split()[1:]]
        idle, total = v[3] + v[4], sum(v)
        if self.stat:
            dt = total - self.stat[1]
            if dt > 0:
                self.idle = 0.5 * self.idle + 0.5 * (idle - self.stat[0]) / dt
        self.stat = (idle, total)

    def clock(self):
        return time.time()

    def spare(self):
        """Host idle > 30% over the last polls, >= 8 GiB available, low memory pressure."""
        try:
            mem = {l.split(":")[0]: int(l.split()[1]) for l in open("/proc/meminfo")}
            some = float(open("/proc/pressure/memory").read().split()[1].split("=")[1])   # some avg10
        except (OSError, ValueError, IndexError):
            return False
        return self.idle > 0.30 and mem["MemAvailable"] >= 8 << 20 and some < 5

    def container(self, job):
        return "kb-" + self.run_id + "-" + re.sub(r"[^A-Za-z0-9_.-]", "_", job.name)

    def start(self, job):
        _, _, hours = job.spec()
        mem = job.mem
        swap = mem + 12 if job.cls == "heavy" else mem + mem // 2  # zram swap also costs RAM: leave the desktop room
        env = dict(os.environ, KBUILD_JOBS=str(job.jobs()), KBUILD_CPUS=str(len(job.cpus) or job.jobs()),
                   KBUILD_CPUSET=",".join(map(str, job.cpus)), KBUILD_MEMORY=f"{mem}g", KBUILD_MEMORY_SWAP=f"{swap}g",
                   KBUILD_KNOBS=",".join(job.knobs), KBUILD_RUN_ID=self.run_id)
        out = open(os.path.join(self.run_dir, job.name + ".one.log"), "a")  # kbuild-run's own errors (artifact checks, repo-add)
        p = subprocess.Popen([os.path.join(HERE, "kbuild-run"), "one", self.run_id, job.name], env=env,
                             stdout=out, stderr=subprocess.STDOUT, start_new_session=True)
        out.close()
        self.procs[job.name] = (p, job, time.time(), hours * 3600)

    def tail(self, job, n=200):
        path = os.path.join(self.run_dir, job.name + ".log")
        try:
            with open(path, "rb") as f:
                f.seek(0, 2)
                f.seek(max(0, f.tell() - 65536))
                data = f.read().decode(errors="replace")
        except OSError:
            return ""
        keep = os.path.join(self.run_dir, f"{job.name}.tier{job.tier}.log")
        try:
            os.replace(path, keep)
        except OSError:
            pass
        try:
            with open(os.path.join(self.run_dir, job.name + ".one.log"), errors="replace") as f:
                data += "\n" + f.read()[-4000:]
        except OSError:
            pass
        lines = data.splitlines()
        # pacman lists every conflicting file after its error line: keep that line however long the list is
        early = [l for l in lines[:-n] if PACMAN_FAIL.search(l)]
        return "\n".join(early + lines[-n:])

    def kill(self, job):
        subprocess.run(["sudo", "docker", "kill", self.container(job)], capture_output=True)

    def wait(self):
        while True:
            out = []
            for name, (p, job, t0, limit) in list(self.procs.items()):
                rc = p.poll()
                if rc is None and time.time() - t0 > limit:
                    self.kill(job)
                    os.killpg(p.pid, signal.SIGKILL)
                    p.wait()
                    del self.procs[name]
                    out.append((job, 124, "kbuild-pool: timeout", time.time() - t0))
                elif rc is not None:
                    del self.procs[name]
                    out.append((job, rc, self.tail(job), time.time() - t0))
            self.sample()
            if out or (self.idle > 0.30 and time.time() - self.woke > 15):
                self.woke = time.time()   # an idle host re-runs admission even without completions
                return out
            time.sleep(3)

    def stop(self):
        for p, job, _, _ in self.procs.values():
            self.kill(job)
            os.killpg(p.pid, signal.SIGKILL)


def read_list(path, waves):
    out = []
    for line in open(path):
        line = line.split("#")[0].strip()
        if not line:
            continue
        name, _, wave = line.partition("\t")
        if waves and wave.strip() not in waves:
            continue
        out.append((name.strip(), wave.strip() or "D"))
    return out


def read_tune():
    tune = {}
    path = os.path.join(PKGS, "build.tune")
    for line in open(path) if os.path.exists(path) else ():
        if line.strip() and not line.startswith("#"):
            f = line.rstrip("\n").split("\t")
            tune[f[0]] = [k for k in f[1].split(",") if k]
    return tune


def snapshot_isize():
    date = open(os.path.join(HERE, "conf/standin.date")).read().strip().replace("/", "-")
    size = {}
    for r in ("core", "extra", "multilib"):
        path = os.path.join(ROOT, "cache/standin", date, "raw", r + ".db")
        if not os.path.exists(path):
            continue
        with tarfile.open(path) as tf:
            for m in tf:
                if m.name.endswith("/desc"):
                    t = tf.extractfile(m).read().decode()
                    base = re.search(r"%BASE%\n(.*)\n", t) or re.search(r"%NAME%\n(.*)\n", t)
                    isz = re.search(r"%ISIZE%\n(\d+)", t)
                    size[base.group(1)] = size.get(base.group(1), 0) + int(isz.group(1) if isz else 0)
    return size


def reuse_hints(names):
    """Targets whose recorded build (<logs>/<name>.recipe line 14) still matches the recipe: kbuild-run's own
    recipe_fingerprint, run once over every target dir. kbuild-run re-checks everything else."""
    paths = dict(l.split("\t", 1) for l in subprocess.run([sys.executable, os.path.join(HERE, "kbuild-sched.py"), "path"],
                                                        capture_output=True, text=True, check=True).stdout.splitlines())
    want = [n for n in names if n in paths and os.path.exists(os.path.join(LOGS, n + ".done"))]
    script = ('eval "$(sed -n \'/^recipe_fingerprint()/,/^}/p\' "$1")"; shift\n'
              'while read -r n d; do printf "%s %s\\n" "$n" "$(recipe_fingerprint "$d")"; done')
    feed = "".join(f"{n} {paths[n].strip()}\n" for n in want)
    out = subprocess.run(["bash", "-c", script, "_", os.path.join(HERE, "kbuild-run")], input=feed,
                         capture_output=True, text=True).stdout
    hints = set()
    for line in out.splitlines():
        n, _, h = line.partition(" ")
        try:
            rec = open(os.path.join(LOGS, n + ".recipe")).read().splitlines()
        except OSError:
            continue
        if h and len(rec) >= 14 and rec[13] == h:
            hints.add(n)
    return hints


def pick_class(name, knobs, durations, isize):
    for k in knobs:
        if k.startswith("class="):
            return k[6:]
    d = durations.get(name)
    if d is not None:
        return "heavy" if d >= 2400 else "large" if d >= 720 else "medium" if d >= 180 else "small"
    if name in HEAVY:
        return "heavy"
    s = isize.get(name, 0) >> 20
    return "large" if s > 200 else "medium" if s > 50 else "small"


class RealPool(Pool):
    def __init__(self, *a, run_dir, durations, durations_path, **kw):
        super().__init__(*a, **kw)
        self.run_dir, self.durations, self.durations_path = run_dir, durations, durations_path
        self.status = open(os.path.join(run_dir, "status.tsv"), "a")
        self.t0 = self.last = time.time()

    def on_success(self, job, seconds):
        self.status.write(f"{job.name}\tbuilt\t{job.tier}\t{job.cls}\t{int(seconds)}\n")
        self.status.flush()
        self.durations[job.name] = max(int(seconds), 1)
        self.progress()

    def poll_requeue(self):
        """Targets listed in <pool dir>/requeue (one per line) are built again; the file is consumed."""
        path = os.path.join(self.run_dir, "requeue")
        try:
            os.replace(path, path + ".taken")
        except FileNotFoundError:
            return
        names = [l.strip() for l in open(path + ".taken") if l.strip() and not l.startswith("#")]
        self.requeue(names, read_tune())

    def on_failure(self, job, kind):
        self.status.write(f"{job.name}\tfail:{kind}\t{job.tier}\t{job.cls}\t{job.tier0_error}\n")
        self.status.flush()
        self.progress()

    def progress(self, force=False):
        now = time.time()
        if not force and now - self.last < 600:
            return
        self.last = now
        tmp = self.durations_path + ".tmp"
        json.dump(self.durations, open(tmp, "w"), indent=0, sort_keys=True)
        os.replace(tmp, self.durations_path)
        built = sum(1 for v in self.finished.values() if v == "built")
        failed = len(self.finished) - built
        left = sum(self.duration(n) * SPEC[self.jobs[n].cls][0] for n in self.pending) / CPU_BUDGET
        self.log(f"progress {time.strftime('%H:%M')}: built {built}, failed {failed}, running {len(self.running)}, "
                 f"pending {len(self.pending)}, eta ~{left / 3600:.1f}h")


def main(argv):
    def opt(name, default=None):
        return argv[argv.index(name) + 1] if name in argv else default

    lst = opt("--list")
    if not lst:
        print(__doc__, file=sys.stderr)
        return 2
    waves = set(opt("--waves", "").split(",")) - {""}
    standin = opt("--standin", "1")
    entries = read_list(lst, waves)
    if not entries:
        print("kbuild-pool: no targets", file=sys.stderr)
        return 1
    tune = read_tune()
    dpath = os.path.join(HERE, "conf/durations.json")
    durations = json.load(open(dpath)) if os.path.exists(dpath) else {}
    isize = snapshot_isize()

    def duration(n):
        return durations.get(n, UNKNOWN_DURATION)

    jobs = [Job(n, pick_class(n, tune.get(n, []), durations, isize), w, tune.get(n, [])) for n, w in entries]

    if "--dry-run" in argv:
        deps = {}
        graph = subprocess.run([sys.executable, os.path.join(HERE, "kbuild-sched.py"), "graph"], capture_output=True, text=True, check=True).stdout
        for line in graph.splitlines():
            n, _, ds = line.partition(":")
            deps[n] = set(ds.split())
        sim = SimRunner(duration)
        pool = Pool(jobs, deps, duration, sim, log=lambda m: None)
        pool.run()
        for ev, n, cls, tier, cpus in pool.history:
            if ev == "start":
                print(f"{n}\t{cls}\tcpus={cpus}")
        print(f"dry-run: {len(jobs)} targets, simulated makespan {sim.now / 3600:.1f}h", file=sys.stderr)
        return 0

    os.makedirs(LOGS, exist_ok=True)
    os.makedirs(OUT, exist_ok=True)
    # a lane is a second concurrent pool over a disjoint target list, with its own lock and a smaller budget
    lane = os.environ.get("KBUILD_POOL_LANE", "")
    locks = [open(os.path.join(d, f".kbuild-run{'.' + lane if lane else ''}.lock"), "w") for d in (LOGS, OUT)]
    for f in locks:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("kbuild-pool: another kbuild run holds the lock", file=sys.stderr)
            return 1
    run_id = opt("--run-id") or time.strftime("pool-%Y%m%d-%H%M%S")
    env = dict(os.environ, KBUILD_STANDIN=standin, KBUILD_RUN_ID=run_id)
    tfile = os.path.join(LOGS, f".pool-{run_id}.targets")
    open(tfile, "w").write("".join(n + "\n" for n, _ in entries))
    p = subprocess.run([os.path.join(HERE, "kbuild-run"), "prepare", "--file", tfile], env=env, capture_output=True, text=True)
    if p.returncode:
        print(p.stdout[-2000:] + p.stderr[-2000:], file=sys.stderr)
        return 1
    os.environ.update(KBUILD_STANDIN=standin)
    run_dir = os.path.join(LOGS, "runs", run_id)
    pool_dir = os.path.join(LOGS, "pool", run_id)
    os.makedirs(pool_dir, exist_ok=True)
    deps = {}
    for line in open(os.path.join(run_dir, "graph.txt")):
        n, _, ds = line.partition(":")
        deps[n.strip()] = set(ds.split())
    logf = open(os.path.join(pool_dir, "pool.log"), "a")

    def log(msg):
        logf.write(msg + "\n")
        logf.flush()

    if os.environ.get("KBUILD_REUSE") == "recipe":
        for n in reuse_hints([j.name for j in jobs]):
            pool_job = next(j for j in jobs if j.name == n)
            pool_job.reuse = True
        log(f"reuse hints: {sum(j.reuse for j in jobs)}")
        # a published earlier build: .artifacts outlives a rebuild that was started (and killed), .done does not
        prebuilt = {j.name for j in jobs if os.path.exists(os.path.join(LOGS, j.name + ".artifacts"))}
    runner = DockerRunner(run_id, run_dir)
    pool = RealPool(jobs, deps, duration, runner, standin=standin != "0", log=log,
                    run_dir=pool_dir, durations=durations, durations_path=dpath)
    if os.environ.get("KBUILD_REUSE") == "recipe":
        pool.prebuilt = prebuilt   # build against the published copy instead of waiting for its rebuild (gcc)
    signal.signal(signal.SIGTERM, lambda *_: (runner.stop(), sys.exit(143)))
    log(f"pool {run_id}: {len(jobs)} targets, standin={standin}")
    try:
        result = pool.run()
    finally:
        pool.progress(force=True)
    counts = {}
    for v in result.values():
        counts[v] = counts.get(v, 0) + 1
    fin = [os.path.join(HERE, "kbuild-run"), "finish", run_id] + (["--publish"] if "--publish" in argv else [])
    f = subprocess.run(fin, env=env, capture_output=True, text=True)
    summary = (f"run {run_id}: " + ", ".join(f"{k} {v}" for k, v in sorted(counts.items())) + "\n"
               + "\n".join(f"{n}\t{v}" for n, v in sorted(result.items()) if v != "built") + "\n"
               + f"finish rc={f.returncode}\n" + f.stdout[-3000:] + f.stderr[-3000:])
    open(os.path.join(pool_dir, "summary.txt"), "w").write(summary)
    log(summary)
    print(summary.splitlines()[0])
    return 0 if f.returncode == 0 else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
