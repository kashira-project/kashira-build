#!/bin/bash
# kbuild — kashira build driver (P0: container build primitive).
#
#   kbuild build <pkgdir> [pkgdir...]   build pkgbases in clean containers
#   kbuild wave <listfile>              build pkgdirs listed (one per line),
#                                       repo-adding each result so later
#                                       entries see earlier builds
#
# Defaults and host layout: kbuild-lib.sh.
set -uo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=kbuild-lib.sh
source "$HERE/kbuild-lib.sh"

die() { echo "kbuild: $*" >&2; exit 1; }

bootstrap_prepare() {
  local d name
  local -a names=()
  for d in "$@"; do
    name=$(pkgbase_for "$d") || return 1
    [ -n "$name" ] || { echo "missing pkgbase in $d" >&2; return 1; }
    names+=("$name")
  done
  [ ${#names[@]} -gt 0 ] || return 0
  python3 "$HERE/kbuild-sched.py" preflight --repo "$REPO" "${names[@]}" >/dev/null || return 1
  KBUILD_BOOTSTRAP_DEMOTED=$(python3 "$HERE/kbuild-sched.py" demoted "${names[@]}") || return 1
  export KBUILD_BOOTSTRAP_DEMOTED
}

# build_dir <pkgdir>: build into $OUT/<pkgbase>, replacing earlier artifacts.
build_dir() {
  local pkgdir name
  pkgdir=$(realpath "$1") || return 1
  [ -f "$pkgdir/PKGBUILD" ] || { echo "SKIP $pkgdir (no PKGBUILD)"; return 1; }
  name=$(pkgbase_for "$pkgdir")
  [ -n "$name" ] || { echo "missing pkgbase in $pkgdir" >&2; return 1; }
  mkdir -p "$OUT/$name" || return 1
  find "$OUT/$name" -maxdepth 1 -type f -name '*.pkg.tar.zst' -delete || return 1
  build_one "$name" "$pkgdir" "$OUT/$name" && \
    artifact_list "$OUT/$name" "$pkgdir" "$name" >/dev/null || return 1
  if mixed_repo; then
    for pkg in "$OUT/$name"/*.pkg.tar.zst; do
      "$HERE/kbuild-arch-bootstrap" record "$REPO" "$pkg" || return 1
    done
  fi
}

cmd_build() {
  local rc=0
  bootstrap_prepare "$@" || return 1
  for d in "$@"; do
    build_dir "$d" || rc=1
  done
  return $rc
}

cmd_wave() {
  local listfile=$1 line done_marker
  local -a dirs=()
  [ -f "$listfile" ] || die "no such listfile: $listfile"
  build_repo_guard || return 1
  if mixed_repo; then
    mixed_path_ok "$LOGS" "wave logs" || return 1
  fi
  mkdir -p "$LOGS"
  while read -r line; do
    [[ "$line" =~ ^\s*(#|$) ]] && continue
    dirs+=("$line")
  done < "$listfile"
  bootstrap_prepare "${dirs[@]}" || return 1
  for line in "${dirs[@]}"; do
    local name; name=$(pkgbase_for "$line") || return 1
    [ -n "$name" ] || { echo "missing pkgbase in $line" >&2; return 1; }
    done_marker="$LOGS/$name.done"
    if [ -f "$done_marker" ]; then echo "== wave: $name already done"; continue; fi
    if build_dir "$line" > "$LOGS/$name.log" 2>&1 && repo_add "$OUT/$name" "$line" "$name"; then
      touch "$done_marker"
      echo "== wave: $name OK"
    else
      echo "== wave: $name FAILED (log: $LOGS/$name.log)"
      return 1
    fi
  done < "$listfile"
  echo "== wave complete"
}

case "${1:-}" in
  build) shift; cmd_build "$@" ;;
  wave)  shift; cmd_wave "$@" ;;
  *) die "usage: kbuild build <pkgdir>... | kbuild wave <listfile>" ;;
esac
