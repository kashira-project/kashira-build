#!/bin/bash
# kbuild — kashira build driver (P0: container build primitive).
#
#   kbuild build <pkgdir> [pkgdir...]   build pkgbases in clean containers
#   kbuild wave <listfile>              build pkgdirs listed (one per line),
#                                       repo-adding each result so later
#                                       entries see earlier builds
#
# Host layout (paths overridable via env):
#   KBUILD_IMAGE   container image     (dakkshesh07/kashira:base-devel-2026-10-03)
#   KBUILD_REPO    local repo dir      (/mnt/lfs/var/cache/pacman/kashira)
#   KBUILD_SOURCES source cache        (/mnt/lfs/sources)
#   KBUILD_OUT     artifacts root      (<here>/out)
#   KBUILD_LOGS    logs root           (<here>/logs)
set -uo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
IMAGE=${KBUILD_IMAGE:-dakkshesh07/kashira:base-devel-2026-10-03}
REPO=${KBUILD_REPO:-/mnt/lfs/var/cache/pacman/kashira}
SOURCES=${KBUILD_SOURCES:-/mnt/lfs/sources}
OUT=${KBUILD_OUT:-$HERE/out}
LOGS=${KBUILD_LOGS:-$HERE/logs}

die() { echo "kbuild: $*" >&2; exit 1; }

# pkg_deps <pkgdir> -> space-separated pacman dependency expressions
pkg_deps() {
  local info entries line field expr name base
  local -A own=() provided=() seen=()
  local scratch
  scratch=$(mktemp -d) || return 1
  info=$(cd "$1" && BUILDDIR="$scratch" PKGDEST="$scratch" SRCDEST="$scratch" SRCPKGDEST="$scratch" LOGDEST="$scratch" makepkg --printsrcinfo)
  local rc=$?
  rm -rf -- "$scratch"
  [ "$rc" -eq 0 ] || return "$rc"
  entries=$(bsdtar -tf "$REPO/kashira.db.tar.gz") || return 1
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*([a-z_0-9]+)[[:space:]]+=[[:space:]]+(.*)$ ]] || continue
    field=${BASH_REMATCH[1]} expr=${BASH_REMATCH[2]}
    [ -n "$expr" ] || continue
    case "$field" in
      pkgbase) base=$expr ;;
      pkgname) own[$expr]=1 ;;
      provides|provides_x86_64)
        name=${expr%%[\<\>\=]*}; provided[$name]=1 ;;
    esac
  done <<<"$info"
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*(depends|makedepends|depends_x86_64|makedepends_x86_64)[[:space:]]+=[[:space:]]+(.*)$ ]] || continue
    expr=${BASH_REMATCH[2]}
    [ -n "$expr" ] || continue
    name=${expr%%[\<\>\=]*}
    name=${name%:any}; name=${name%:x86_64}
    [ -z "${provided[$name]+set}" ] || continue
    if [ -n "${own[$name]+set}" ]; then
      # Never ask pacman to install the pkgbase we are building: that would pull
      # the previous release of this very package (stale metadata, and it can
      # drag in deps we are about to replace). Sibling splits are different —
      # gcc-runtime legitimately provides the libstdc++ headers and CRT objects
      # clang++ needs to build the compiler, so keep those when the repo has
      # them, unversioned so the version we are producing cannot leak in.
      [ "$name" = "$base" ] && continue
      if awk -v n="$name" 'index($0, n "-") == 1 && /\/desc$/ { found=1; exit } END { exit !found }' <<<"$entries"; then
        expr=$name
      else
        continue
      fi
    fi
    [ -z "${seen[$expr]+set}" ] || continue
    seen[$expr]=1
    printf '%s ' "$expr"
  done <<<"$info"
}

# build_one <pkgdir>: returns 0/1, artifacts land in $OUT/<pkgbase>/
build_one() {
  local pkgdir=$1 name deps
  pkgdir=$(realpath "$pkgdir")
  [ -f "$pkgdir/PKGBUILD" ] || { echo "SKIP $pkgdir (no PKGBUILD)"; return 1; }
  name=$(basename "$pkgdir")
  deps=$(pkg_deps "$pkgdir") || return 1
  mkdir -p "$OUT/$name"
  echo "== build $name (deps: ${deps:-none})"
  sudo docker run --rm \
    -e KBUILD_DEPS="$deps" \
    -e KBUILD_SKIP_UPGRADE="${KBUILD_SKIP_UPGRADE:-0}" \
    -e KBUILD_KEEP_SRC="${KBUILD_KEEP_SRC:-}" \
    -e KBUILD_MAKEPKG_CONF="${KBUILD_MAKEPKG_CONF:-}" \
    -v "$pkgdir":/pkg:ro \
    -v "$SOURCES":/sources \
    -v "$OUT/$name":/out \
    -v "$REPO":/repo:ro \
    -v "$HERE":/kbuild:ro \
    ${KBUILD_KEEP_SRC:+-v "$OUT/$name/src":/work} \
    -v "$HERE/conf/soname_provides.sh":/usr/share/makepkg/autodep/soname_provides.sh:ro \
    "$IMAGE" /kbuild/kbuild-inside.sh
}

# repo_add <outdir>: add built packages to the local repo (serialized)
repo_add() {
  local outdir=$1 pkg destination
  local -a inrepo=()
  shopt -s nullglob
  local pkgs=("$outdir"/*.pkg.tar.zst)
  shopt -u nullglob
  [ ${#pkgs[@]} -gt 0 ] || return 1
  (
    flock 9 || exit 1
    for pkg in "${pkgs[@]}"; do
      destination=$REPO/$(basename "$pkg")
      cp -f -- "$pkg" "$destination" || exit 1
      cmp -s -- "$pkg" "$destination" || exit 1
      inrepo+=("$destination")
    done
    repo-add "$REPO/kashira.db.tar.gz" "${inrepo[@]}"
  ) 9>"$REPO/.kbuild.lock"
}

cmd_build() {
  local rc=0
  for d in "$@"; do
    build_one "$d" || rc=1
  done
  return $rc
}

cmd_wave() {
  local listfile=$1 line done_marker
  [ -f "$listfile" ] || die "no such listfile: $listfile"
  mkdir -p "$LOGS"
  while read -r line; do
    [[ "$line" =~ ^\s*(#|$) ]] && continue
    local name; name=$(basename "$line")
    done_marker="$LOGS/$name.done"
    if [ -f "$done_marker" ]; then echo "== wave: $name already done"; continue; fi
    if build_one "$line" > "$LOGS/$name.log" 2>&1 && repo_add "$OUT/$name"; then
      touch "$done_marker"
      echo "== wave: $name OK"
    else
      echo "== wave: $name FAILED (log: $LOGS/$name.log)"
      return 1
    fi
  done < "$listfile"
  echo "== wave complete"
}

case "${1:-}" in
  build) shift; cmd_build "$@" ;;
  wave)  shift; cmd_wave "$@" ;;
  *) die "usage: kbuild build <pkgdir>... | kbuild wave <listfile>" ;;
esac
