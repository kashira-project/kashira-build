#!/bin/bash
# kbuild-run — dependency-aware build runs.
#
#   kbuild-run prepare --file <list> | <pkgbase...> | --all   plan a run; prints its id
#   kbuild-run one <run_id> <pkgbase>                          build one target (kbuild-pool calls this)
#   kbuild-run finish <run_id> [--publish]                     manifest + verify gate (+ publish)
#   kbuild-run run [--no-publish] <targets>                    all three, sequential (small manual runs)
#
# Builds in fresh containers. Successful packages enter the local repo; finish publishes those whose
# dependencies the repo satisfies. Remote publication is ordered, not atomic.
set -uo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
# Packages tracked by reference in arch.manifest must exist as recipe dirs before scheduling.
if [ "${1:-}" = prepare ] || [ "${1:-}" = run ]; then
  KSYNC_ROOT=${KBUILD_PKGS:-$HERE/../kashira-pkgs} python3 "$HERE/../kashira-pkgs/tools/ksync/ksync.py" materialize >/dev/null || { echo "kbuild-run: manifest materialize failed" >&2; exit 1; }
fi
# shellcheck source=kbuild-lib.sh
source "$HERE/kbuild-lib.sh"
KBUILD_BOOTSTRAP_EDGES=${KBUILD_BOOTSTRAP_EDGES:-}
KBUILD_BOOTSTRAP_DEMOTED=${KBUILD_BOOTSTRAP_DEMOTED:-}
export KBUILD_BOOTSTRAP_EDGES KBUILD_BOOTSTRAP_DEMOTED
validate_build_settings || exit 2

sched() { python3 "$HERE/kbuild-sched.py" "$@"; }

# A run has isolated logs, output, status, and candidate manifest. Canonical
# output remains in OUT so a later run can reuse verified artifacts.
RUNS=$LOGS/runs
RUN_ID=${KBUILD_RUN_ID:-$(date +%Y%m%d-%H%M%S)-$$}
set_run() {
  RUN_ID=$1
  [[ "$RUN_ID" =~ ^[A-Za-z0-9_.-]+$ && "$RUN_ID" != . && "$RUN_ID" != .. ]] || { echo "invalid run id: $RUN_ID" >&2; return 2; }
  RUN_DIR=$RUNS/$RUN_ID
  RUN_OUT=$RUN_DIR/out
  MANIFEST=$RUN_DIR/candidates.manifest
}
set_run "$RUN_ID" || exit 2

mkdir_run() {
  mkdir -p "$RUNS" || return 1
  mkdir "$RUN_DIR" "$RUN_OUT" || return 1
  printf '%s\n' running > "$RUN_DIR/status"
}

run_status() {
  printf '%s\n' "$1" > "$RUN_DIR/status"
}

declare -A PKGDIR=()
declare -A DIRPKG=()
declare -A BASEPKG=()
load_pkgdirs() {
  local data n d real base
  if [ -n "${PKGDIRS_FILE:-}" ]; then data=$(<"$PKGDIRS_FILE"); else data=$(sched path); fi || return 1
  while IFS=$'\t' read -r n d; do
    [ -n "$n" ] || continue
    real=$(realpath "$d") || return 1
    [ -f "$real/PKGBUILD" ] || return 1
    [ -z "${PKGDIR[$n]+set}" ] || { echo "duplicate pkgbase: $n" >&2; return 1; }
    [ -z "${DIRPKG[$real]+set}" ] || { echo "duplicate pkgdir: $real" >&2; return 1; }
    base=$(basename "$real")
    [ -z "${BASEPKG[$base]+set}" ] || { echo "ambiguous pkgdir basename: $base" >&2; return 1; }
    PKGDIR[$n]=$real
    DIRPKG[$real]=$n
    BASEPKG[$base]=$n
  done <<<"$data"
  [ ${#PKGDIR[@]} -gt 0 ] || { echo "scheduler returned no package directories" >&2; return 1; }
}

resolve_target() {
  local arg=$1 real
  if [ -n "${PKGDIR[$arg]+set}" ]; then
    printf '%s\n' "$arg"
    return 0
  fi
  real=$(realpath "$arg" 2>/dev/null) || real=
  if [ -n "$real" ] && [ -n "${DIRPKG[$real]+set}" ]; then
    printf '%s\n' "${DIRPKG[$real]}"
    return 0
  fi
  if [ -n "${BASEPKG[$arg]+set}" ]; then
    printf '%s\n' "${BASEPKG[$arg]}"
    return 0
  fi
  echo "unknown target: $arg" >&2
  return 1
}

copy_canonical() {
  local pkgbase=$1 pkgdir=$2 src=$3 f files recorded=$LOGS/$1.artifacts
  files=$(artifact_list "$src" "$pkgdir" "$pkgbase") || return 1
  mkdir -p "$OUT/$pkgbase" || return 1
  find "$OUT/$pkgbase" -maxdepth 1 -type f -name '*.pkg.tar.zst' -delete || return 1
  : > "$recorded"
  while IFS= read -r f; do
    cp -f "$f" "$OUT/$pkgbase/" || return 1
    sha256sum "$OUT/$pkgbase/$(basename "$f")" >> "$recorded" || return 1
  done <<<"$files"
}

recipe_fingerprint() {
  local pkgdir=$1 listing digest
  [ -f "$pkgdir/PKGBUILD" ] || return 1
  listing=$(mktemp) || return 1
  # Relative paths, and no sync control files: moving a recipe or touching
  # arch.ref/url.override/hold/arch.name must not change its fingerprint.
  if ! (cd "$pkgdir" && find . -mindepth 1 -type d \( -name .git -o -name src -o -name pkg \) -prune -o \
      \( -type f -o -type l \) ! -path ./arch.ref ! -path ./arch.name ! -path ./url.override ! -path ./hold \
      -print0) > "$listing"; then
    rm -f "$listing"
    return 1
  fi
  digest=$(cd "$pkgdir" && sort -z "$listing" | xargs -0 -r sha256sum | sha256sum | cut -d ' ' -f1)
  local rc=$?
  rm -f "$listing"
  [ "$rc" -eq 0 ] || return 1
  printf '%s\n' "$digest"
}

# Only inputs that change what a build produces: moving the workspace, resizing containers or editing the
# scheduler (kbuild-lib.sh, kbuild-sched.py, kbuild-pool) keeps every artifact reusable.
fingerprint_head() {
  local pkgbase=$1 tier=$2
  printf 'repo: %s\nimage: %s\nconfig: %s\nskip-upgrade: %s\noverwrite: %s\nstandin: %s %s\ntune: %s\ntier: %s\n' \
    "$REPO" "$IMAGE_ID" "$MAKEPKG_CONF" "${KBUILD_SKIP_UPGRADE:-0}" "${KBUILD_OVERWRITE:-}" "${KBUILD_STANDIN:-1}" \
    "$(<"$HERE/conf/standin.date")" "$(tune_knobs "$pkgbase")" "$tier"
  (cd "$HERE" && sha256sum kbuild-inside.sh "conf/$MAKEPKG_CONF" conf/soname_provides.sh conf/cmake-wrapper.sh \
    conf/cmake-project-include.cmake) || return 1
  recipe_fingerprint "${PKGDIR[$pkgbase]}"
}

# build_fingerprint <pkgbase>: the fingerprint of the recorded build (its tier), all deps recorded.
build_fingerprint() {
  local pkgbase=$1 dep tier=0
  [ ! -s "$LOGS/$pkgbase.tier" ] || tier=$(<"$LOGS/$pkgbase.tier")
  fingerprint_head "$pkgbase" "$tier" || return 1
  for dep in ${GRAPH[$pkgbase]:-}; do
    [ -s "$LOGS/$dep.identity" ] && [ -f "$LOGS/$dep.done" ] || return 1
    sha256sum "$LOGS/$dep.identity" || return 1
    recipe_fingerprint "${PKGDIR[$dep]}" || return 1
  done
}

# build_fingerprint_for_build <pkgbase>: same for the build about to run; an unbuilt dep (a stand-in) is named.
build_fingerprint_for_build() {
  local pkgbase=$1 dep
  fingerprint_head "$pkgbase" "${KBUILD_TIER:-0}" || return 1
  for dep in ${GRAPH[$pkgbase]:-}; do
    if [ -s "$LOGS/$dep.identity" ] && [ -f "$LOGS/$dep.done" ]; then
      sha256sum "$LOGS/$dep.identity" || return 1
    else
      printf 'unrecorded dependency: %s\n' "$dep"
    fi
    recipe_fingerprint "${PKGDIR[$dep]}" || return 1
  done
}

repo_matches() {
  local file=$1 filename=${1##*/} digest
  cmp -s -- "$file" "$REPO/$filename" || return 1
  digest=$(sha256sum "$file") || return 1
  # "filename digest" for every db entry, extracted once per db version (inode+mtime) and shared by all jobs
  local db=$REPO/kashira.db.tar.gz cache
  cache=$LOGS/.repo-digests.$(stat -c '%i.%Y' "$db") || return 1
  if [ ! -s "$cache" ]; then
    bsdtar -xOf "$db" '*/desc' | awk '/^%FILENAME%$/ { getline; name = $0 }
      /^%SHA256SUM%$/ { getline; print name, $0 }' > "$cache.$$" && mv -f "$cache.$$" "$cache" || return 1
    find "$LOGS" -maxdepth 1 -name '.repo-digests.*' ! -name "${cache##*/}" -mmin +5 -delete 2>/dev/null
  fi
  grep -qxF "$filename ${digest%% *}" "$cache"
}

reusable_artifacts() {
  local pkgbase=$1 record=$LOGS/$1.artifacts file digest fingerprint validated recorded
  [ -f "$LOGS/$pkgbase.done" ] && [ -s "$LOGS/$pkgbase.recipe" ] && [ -s "$LOGS/$pkgbase.identity" ] || return 1
  if [ "${KBUILD_REUSE:-}" = recipe ]; then
    # KBUILD_REUSE=recipe: keep a build whose own recipe and tune line are unchanged, whatever moved under it
    # (image, kbuild-inside.sh, dependency builds). For fast passes only: the purity pass (Wave P) runs without
    # it. shortcut: lines 7 (tune) and 14 (recipe) of fingerprint_head's layout; update both if the head changes.
    [ "$(sed -n 7p "$LOGS/$pkgbase.recipe")" = "tune: $(tune_knobs "$pkgbase")" ] || return 1
    [ "$(sed -n 14p "$LOGS/$pkgbase.recipe")" = "$(recipe_fingerprint "${PKGDIR[$pkgbase]}")" ] || return 1
  else
    fingerprint=$(build_fingerprint "$pkgbase") || return 1
    [ "$(<"$LOGS/$pkgbase.recipe")" = "$fingerprint" ] || return 1
  fi
  [ -s "$record" ] || return 1
  [ "$(sha256sum "$LOGS/$pkgbase.recipe" "$record" | sha256sum | cut -d ' ' -f1)" = "$(<"$LOGS/$pkgbase.identity")" ] || return 1
  validated=$(artifact_list "$OUT/$pkgbase" "${PKGDIR[$pkgbase]}" "$pkgbase") || return 1
  recorded=$(awk '{print $2}' "$record" | sort) || return 1
  [ "$(printf '%s\n' "$validated" | sort)" = "$recorded" ] || return 1
  while read -r digest file; do
    [ -n "$digest" ] && [ -n "$file" ] && [ -s "$file" ] || return 1
    [[ "$file" == "$OUT/$pkgbase/"*.pkg.tar.zst ]] || return 1
    [ "$(sha256sum "$file")" = "$digest  $file" ] || return 1
    repo_matches "$file" || return 1
    printf '%s\n' "$file"
  done < "$record"
}

build_package() {
  local pkgbase=$1 pkgdir=${PKGDIR[$1]} log="$RUN_DIR/$1.log" fingerprint current
  if ! mixed_repo && [ "$FORCE_REBUILD" != 1 ] && [ -f "$LOGS/$pkgbase.done" ] && reusable_artifacts "$pkgbase" >/dev/null; then
    printf '%s\n' skipped > "$RUN_DIR/$pkgbase.status"
    return 0
  fi
  rm -f "$LOGS/$pkgbase.done"
  # a cycle partner may finish while this builds (pool), so only the recipe itself must hold still
  if fingerprint=$(recipe_fingerprint "$pkgdir") \
      && rm -rf "${RUN_OUT:?}/$pkgbase" \
      && build_one "$pkgbase" "$pkgdir" "$RUN_OUT/$pkgbase" >"$log" 2>&1 \
      && artifact_list "$RUN_OUT/$pkgbase" "$pkgdir" "$pkgbase" >/dev/null \
      && current=$(recipe_fingerprint "$pkgdir") \
      && [ "$current" = "$fingerprint" ] \
      && { ! mixed_repo || { for f in "$RUN_OUT/$pkgbase"/*.pkg.tar.zst; do "$HERE/kbuild-arch-bootstrap" record "$REPO" "$f" || return 1; done; }; } \
      && repo_add "$RUN_OUT/$pkgbase" "$pkgdir" "$pkgbase" \
      && { record_build "$pkgbase"; true; } \
      && { mixed_repo || copy_canonical "$pkgbase" "$pkgdir" "$RUN_OUT/$pkgbase"; } \
      && { ! mixed_repo || { cp "$RUN_OUT/$pkgbase/.installed-packages" "$RUN_DIR/$pkgbase.installed-packages" && cp "$RUN_OUT/$pkgbase/.origin-snapshot" "$RUN_DIR/$pkgbase.origin-snapshot" && : > "$LOGS/$pkgbase.artifacts" && for f in "$RUN_OUT/$pkgbase"/*.pkg.tar.zst; do sha256sum "$f" >> "$LOGS/$pkgbase.artifacts"; done; }; } \
      && { if [ -s "$RUN_OUT/$pkgbase/.standins" ]; then cp "$RUN_OUT/$pkgbase/.standins" "$LOGS/$pkgbase.standins"; else rm -f "$LOGS/$pkgbase.standins"; fi; } \
      && printf '%s\n' "${KBUILD_TIER:-0}" > "$LOGS/$pkgbase.tier" \
      && fingerprint=$(build_fingerprint_for_build "$pkgbase") \
      && printf '%s\n' "$fingerprint" > "$LOGS/$pkgbase.recipe" \
      && sha256sum "$LOGS/$pkgbase.recipe" "$LOGS/$pkgbase.artifacts" | sha256sum | cut -d ' ' -f1 > "$LOGS/$pkgbase.identity" \
      && touch "$LOGS/$pkgbase.done"; then
    rm -f "$LOGS/$pkgbase.failed"
    printf '%s\n' built > "$RUN_DIR/$pkgbase.status"
    return 0
  fi
  if [ -n "${current:-}" ] && [ "$current" != "$fingerprint" ]; then
    echo "recipe changed during build: $pkgbase" >&2
  fi
  cp -f "$log" "$LOGS/$pkgbase.log" 2>/dev/null || true
  printf '%s\n' failed > "$RUN_DIR/$pkgbase.status"
  printf 'FAILED %s\n' "$pkgbase" > "$LOGS/$pkgbase.failed"
  return 1
}

# record_build <pkgbase>: store ABI facts of the just-built packages and append their impact to the run report.
record_build() {
  local m=$RUN_DIR/$1.manifest f
  for f in "$RUN_OUT/$1"/*.pkg.tar.*; do printf 'artifact\t%s\t%s\n' "$1" "$f"; done > "$m"
  flock "$LOGS/.kplan.lock" python3 "$HERE/../kashira-pkgs/tools/kplan/kplan.py" record "$m" --report "$m.impact" \
    && flock "$LOGS/.kplan.lock" sh -c 'cat "$1" >> "$2"' sh "$m.impact" "$RUN_DIR/impact.tsv" \
    || echo "warning: build record not stored for $1" >&2
}

# publish_snapshot: commit the slim build-record snapshot CI's sync reads for rebuild prediction (only that file).
publish_snapshot() {
  local pk=$HERE/../kashira-pkgs
  python3 "$pk/tools/kplan/kplan.py" snapshot "$pk/kstate.jsonl" || return 1
  git -C "$pk" diff --quiet -- kstate.jsonl && return 0
  git -C "$pk" commit -q -m "kstate: refresh build-record snapshot (run $RUN_ID)" -- kstate.jsonl && git -C "$pk" push -q
}

capture_targets() {
  local mode=$1 listfile=${2:-} data line
  case "$mode" in
    all)
      data=$(sched graph) || return 1
      while IFS= read -r line; do
        [ -n "$line" ] || continue
        targets+=("${line%%:*}")
      done <<<"$data"
      ;;
    file)
      [ -f "$listfile" ] || { echo "no such target list: $listfile" >&2; return 1; }
      while IFS= read -r line || [ -n "$line" ]; do
        line=${line%%#*}
        line=${line#"${line%%[![:space:]]*}"}
        line=${line%"${line##*[![:space:]]}"}
        [ -n "$line" ] || continue
        p=$(resolve_target "$line") || return 1
        targets+=("$p")
      done < "$listfile"
      ;;
    dirty)
      shift
      data=$(sched dirty "$@") || return 1
      while IFS= read -r line; do
        [ -n "$line" ] || continue
        p=${line%%[[:space:]]*}
        targets+=("$p")
      done <<<"$data"
      ;;
  esac
}

dedupe_targets() {
  local -A seen=() out=() p
  for p in "${targets[@]}"; do
    p=$(resolve_target "$p") || return 1
    [ -n "${seen[$p]+set}" ] || { seen[$p]=1; out[${#out[@]}]=$p; }
  done
  targets=()
  for p in "${out[@]}"; do targets+=("$p"); done
}

# kbuild-run prepare [--file <list> | <pkgbase...>]: plan a run (RUN_DIR/state.env, graph.txt, targets) and print its id.
# Positional targets force rebuilds through their reverse closure. The caller holds the run lock (run, kbuild-pool).
cmd_prepare() {
  local -a targets=()
  local data FORCE_REBUILD=0 IMAGE_ID MAKEPKG_CONF LEDGER_DIGEST=none
  build_repo_guard || return 1
  if mixed_repo; then
    mixed_path_ok "$LOGS" "run logs" || return 1
  fi
  mkdir -p "$LOGS" "$OUT" || return 1
  mkdir_run || { echo "cannot create run directory: $RUN_DIR" >&2; return 1; }
  load_pkgdirs || { run_status failed; return 1; }
  if [ "${1:-}" = --all ]; then
    capture_targets all || { run_status failed; return 1; }
  elif [ "${1:-}" = --file ]; then
    [ $# -eq 2 ] || { echo "--file requires a list" >&2; run_status failed; return 2; }
    capture_targets file "$2" || { run_status failed; return 1; }
  else
    [ $# -gt 0 ] && [[ "$1" != --* ]] || { echo "missing or invalid targets" >&2; run_status failed; return 2; }
    FORCE_REBUILD=1
    capture_targets dirty "$@" || { run_status failed; return 1; }
  fi
  dedupe_targets || { run_status failed; return 1; }
  MAKEPKG_CONF=${KBUILD_MAKEPKG_CONF:-makepkg.conf}
  if [[ "$MAKEPKG_CONF" == */* || "$MAKEPKG_CONF" == . || "$MAKEPKG_CONF" == .. ]] || [ ! -f "$HERE/conf/$MAKEPKG_CONF" ]; then
    echo "invalid KBUILD_MAKEPKG_CONF: $MAKEPKG_CONF" >&2
    run_status failed
    return 2
  fi
  if [ ${#targets[@]} -gt 0 ]; then
    sched preflight --repo "$REPO" "${targets[@]}" >/dev/null || { run_status failed; return 1; }
  fi
  if [ "${KBUILD_STANDIN:-1}" = 0 ]; then
    # no stand-ins (wave P): cycles among unbuilt targets get a stage-1 member, built without its partners
    KBUILD_BOOTSTRAP_DEMOTED=$(sched demoted "${targets[@]}" 2>/dev/null) || { run_status failed; return 1; }
    data=$(sched stage1 "${targets[@]}") || { run_status failed; return 1; }
    printf '%s\n' "$data" | cut -f1 | sed '/^$/d' | sort -u > "$RUN_DIR/stage1.list"
    [ -z "$data" ] || KBUILD_BOOTSTRAP_DEMOTED+=$'\n'"$data"
  fi
  IMAGE_ID=$(sudo docker image inspect --format '{{.Id}}' "$IMAGE") || { run_status failed; return 1; }
  [ -n "$IMAGE_ID" ] || { run_status failed; return 1; }
  printf '%s\n' "${targets[@]}" | sed '/^$/d' > "$RUN_DIR/targets" || { run_status failed; return 1; }
  sched graph > "$RUN_DIR/graph.txt" || { run_status failed; return 1; }
  sched path > "$RUN_DIR/pkgdirs.txt" || { run_status failed; return 1; }
  KBUILD_STANDIN=${KBUILD_STANDIN:-1}
  declare -p IMAGE_ID MAKEPKG_CONF LEDGER_DIGEST FORCE_REBUILD REPO KBUILD_STANDIN KBUILD_BOOTSTRAP_DEMOTED \
    | sed 's/^declare -[-a-zA-Z]* /declare -g /' > "$RUN_DIR/state.env" || { run_status failed; return 1; }
  run_status prepared
  printf '%s\n' "$RUN_ID"
}

# load_run <run_id>: the state cmd_prepare recorded (globals, GRAPH, PKGDIR, targets).
declare -A GRAPH=()
load_run() {
  set_run "$1" || return 1
  [ -s "$RUN_DIR/state.env" ] || { echo "no prepared run: $1" >&2; return 1; }
  # shellcheck disable=SC1091
  source "$RUN_DIR/state.env" || return 1
  export KBUILD_STANDIN KBUILD_BOOTSTRAP_DEMOTED
  local lvl
  while IFS= read -r lvl; do
    [ -n "$lvl" ] || continue
    GRAPH[${lvl%%:*}]=${lvl#*: }
  done < "$RUN_DIR/graph.txt"
  PKGDIRS_FILE=$RUN_DIR/pkgdirs.txt load_pkgdirs || return 1
  mapfile -t targets < "$RUN_DIR/targets"
}

# kbuild-run one <run_id> <pkgbase>: build one target of a prepared run; exit status is the build result.
cmd_one() {
  local -a targets=()
  local pkgbase=$2
  load_run "$1" || return 2
  [ -n "${PKGDIR[$pkgbase]+set}" ] || { echo "unknown pkgbase: $pkgbase" >&2; return 2; }
  rm -f "${LOGS:?}/${pkgbase:?}.failed"
  build_package "$pkgbase"
}

# kbuild-run finish <run_id> [--publish]: manifest of the targets that built and whose dependencies the repo
# satisfies (directly or through other built ones), the verify gate, and optional publication. Refuses to publish
# while a controlled (wave 0) package of the run failed.
cmd_finish() {
  local -a targets=() ok=() failed=() pub=() held=()
  local p f status pk=$HERE/../kashira-pkgs publish=0 files name keep controlled
  [ "${2:-}" != --publish ] || publish=1
  load_run "$1" || return 2
  for p in "${targets[@]}"; do
    status=$(cat "$RUN_DIR/$p.status" 2>/dev/null)
    case "$status" in built|skipped) ok+=("$p") ;; *) failed+=("$p") ;; esac
  done
  local -A unsat=() nopub=()
  while IFS= read -r p; do [ -z "$p" ] || unsat[$p]=1; done \
    < <(python3 "$pk/tools/ksync/ksync.py" verify --repo "$REPO" --closure)
  if [ -f "$pk/ship/nopublish.list" ]; then
    while IFS=$'\t' read -r p _; do [ -z "$p" ] || nopub[$p]=1; done < "$pk/ship/nopublish.list"
  fi
  printf 'kbuild-manifest-v1\n' > "$MANIFEST" || return 1
  for p in "${ok[@]}"; do
    if [ "$(<"$RUN_DIR/$p.status")" = skipped ]; then
      files=$(reusable_artifacts "$p") || { held+=("$p"); continue; }
    else
      files=$(artifact_list "$RUN_OUT/$p" "${PKGDIR[$p]}" "$p") || { held+=("$p"); continue; }
    fi
    keep=1
    while IFS= read -r f; do
      name=$(basename "$f"); name=${name%-*-*-*}
      [ -z "${unsat[$name]+set}" ] || keep=0
    done <<<"$files"
    [ "$keep" = 1 ] || { held+=("$p"); continue; }
    pub+=("$p")
    printf 'requested\t%s\ntarget\t%s\n' "$p" "$p" >> "$MANIFEST"
    while IFS= read -r f; do
      name=$(basename "$f"); name=${name%-*-*-*}
      [ -n "${nopub[$name]+set}" ] || printf 'artifact\t%s\t%s\n' "$p" "$(realpath "$f")" >> "$MANIFEST"
    done <<<"$files"
  done
  printf '%s\n' "${failed[@]}" | sed '/^$/d' > "$RUN_DIR/failed.list"
  printf '%s\n' "${held[@]}" | sed '/^$/d' > "$RUN_DIR/held.list"
  echo "== finish $RUN_ID: ${#pub[@]} publishable, ${#held[@]} held (unsatisfied deps), ${#failed[@]} failed"
  [ ${#pub[@]} -gt 0 ] || { run_status failed; return 1; }
  python3 "$pk/tools/ksync/ksync.py" verify --repo "$REPO" --manifest "$MANIFEST" \
    || { echo "== verify gate failed; see unsatisfied dependencies above" >&2; run_status failed; return 1; }
  [ "$publish" = 1 ] || { run_status prepared; return 0; }
  if mixed_repo; then echo "mixed repository is build-only" >&2; return 1; fi
  [ ! -s "$RUN_DIR/stage1.list" ] || { echo "stage-1 builds present; rebuild them before publishing" >&2; return 1; }
  controlled=$(git -C "$pk" ls-files '*/*/PKGBUILD' | xargs -r -n1 dirname | xargs -r -n1 basename)
  for p in "${failed[@]}"; do
    if grep -qxF "$(basename "${PKGDIR[$p]}")" <<<"$controlled"; then
      echo "controlled package failed: $p; not publishing" >&2
      return 1
    fi
  done
  "$HERE/kbuild-publish" publish --manifest "$MANIFEST" || { run_status failed; return 1; }
  run_status published
  publish_snapshot || echo "warning: kstate.jsonl not refreshed; CI rebuild prediction is stale" >&2
}

# kbuild-run run [--no-publish] <targets>: prepare, build sequentially in dependency order, finish. For small manual
# runs; kbuild-pool is the parallel runner.
cmd_run() {
  local no_publish=0 id p rc=0
  if [ "${1:-}" = --no-publish ]; then no_publish=1; shift; fi
  mkdir -p "$LOGS" "$OUT" || return 1
  exec 8>"$LOGS/.kbuild-run.lock" || return 1
  flock -n 8 || { echo "another kbuild run holds $LOGS/.kbuild-run.lock" >&2; return 1; }
  id=$(cmd_prepare "$@" | tail -n 1) || return 1
  set_run "$id" || return 1
  [ -s "$RUN_DIR/targets" ] || { echo "nothing to build"; return 0; }
  echo "== run: $id ($(wc -l < "$RUN_DIR/targets") pkgbases)"
  # shellcheck disable=SC2046  # one pkgbase per word
  for p in $(sched levels $(<"$RUN_DIR/targets")); do
    ( cmd_one "$id" "$p" ) || { echo "FAILED $p"; rc=1; }
  done
  if [ "$no_publish" = 1 ]; then cmd_finish "$id"; else cmd_finish "$id" --publish; fi || rc=1
  return $rc
}

case "${1:-}" in
  prepare) shift; cmd_prepare "$@"; exit $? ;;
  one) shift; [ $# -eq 2 ] || { echo "usage: kbuild-run one <run_id> <pkgbase>" >&2; exit 2; }; cmd_one "$@"; exit $? ;;
  finish) shift; [ $# -ge 1 ] || { echo "usage: kbuild-run finish <run_id> [--publish]" >&2; exit 2; }; cmd_finish "$@"; exit $? ;;
  run) shift; cmd_run "$@"; exit $? ;;
  *) echo "usage: kbuild-run prepare|one|finish|run ..." >&2; exit 2 ;;
esac
