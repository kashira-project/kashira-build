#!/bin/bash
# kbuild-run — dep-aware parallel build orchestration (P1).
#
#   kbuild run <pkgbase...>     dirty closure + topo-ordered parallel build
#   kbuild run --all            every pkgbase in both repos
#   kbuild run --file <list>    explicit pkgdir list (one per line)
#   kbuild run --no-publish --file <list>  prepare locally without publishing
#
# Builds in fresh containers, with bounded workers within each topo level.
# Successful packages enter the local repo; only a fully successful run may
# publish to testing. Remote publication is ordered, not atomic.
set -uo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=kbuild-lib.sh
source "$HERE/kbuild-lib.sh"
KBUILD_BOOTSTRAP_EDGES=${KBUILD_BOOTSTRAP_EDGES:-}
KBUILD_BOOTSTRAP_DEMOTED=${KBUILD_BOOTSTRAP_DEMOTED:-}
export KBUILD_BOOTSTRAP_EDGES KBUILD_BOOTSTRAP_DEMOTED
WORKERS=${KBUILD_WORKERS:-2}
[[ "$WORKERS" =~ ^[1-9][0-9]*$ ]] || { echo "invalid KBUILD_WORKERS: $WORKERS" >&2; exit 2; }
validate_build_settings || exit 2

sched() { python3 "$HERE/kbuild-sched.py" "$@"; }

# A run has isolated logs, output, status, and candidate manifest. Canonical
# output remains in OUT so a later run can reuse verified artifacts.
RUNS=$LOGS/runs
RUN_ID=${KBUILD_RUN_ID:-$(date +%Y%m%d-%H%M%S)-$$}
[[ "$RUN_ID" =~ ^[A-Za-z0-9_.-]+$ && "$RUN_ID" != . && "$RUN_ID" != .. ]] || { echo "invalid KBUILD_RUN_ID" >&2; exit 2; }
RUN_DIR=$RUNS/$RUN_ID
RUN_OUT=$RUN_DIR/out
MANIFEST=$RUN_DIR/candidates.manifest

mkdir_run() {
  mkdir -p "$RUNS" || return 1
  mkdir "$RUN_DIR" "$RUN_OUT" || return 1
  printf '%s\n' running > "$RUN_DIR/status"
}

run_status() {
  printf '%s\n' "$1" > "$RUN_DIR/status"
}

declare -A PKGDIR=()
declare -A DIRPKG=()
declare -A BASEPKG=()
load_pkgdirs() {
  local data n d real base
  data=$(sched path) || return 1
  while IFS=$'\t' read -r n d; do
    [ -n "$n" ] || continue
    real=$(realpath "$d") || return 1
    [ -f "$real/PKGBUILD" ] || return 1
    [ -z "${PKGDIR[$n]+set}" ] || { echo "duplicate pkgbase: $n" >&2; return 1; }
    [ -z "${DIRPKG[$real]+set}" ] || { echo "duplicate pkgdir: $real" >&2; return 1; }
    base=$(basename "$real")
    [ -z "${BASEPKG[$base]+set}" ] || { echo "ambiguous pkgdir basename: $base" >&2; return 1; }
    PKGDIR[$n]=$real
    DIRPKG[$real]=$n
    BASEPKG[$base]=$n
  done <<<"$data"
  [ ${#PKGDIR[@]} -gt 0 ] || { echo "scheduler returned no package directories" >&2; return 1; }
}

resolve_target() {
  local arg=$1 real
  if [ -n "${PKGDIR[$arg]+set}" ]; then
    printf '%s\n' "$arg"
    return 0
  fi
  real=$(realpath "$arg" 2>/dev/null) || real=
  if [ -n "$real" ] && [ -n "${DIRPKG[$real]+set}" ]; then
    printf '%s\n' "${DIRPKG[$real]}"
    return 0
  fi
  if [ -n "${BASEPKG[$arg]+set}" ]; then
    printf '%s\n' "${BASEPKG[$arg]}"
    return 0
  fi
  echo "unknown target: $arg" >&2
  return 1
}

copy_canonical() {
  local pkgbase=$1 pkgdir=$2 src=$3 f files recorded=$LOGS/$1.artifacts
  files=$(artifact_list "$src" "$pkgdir" "$pkgbase") || return 1
  mkdir -p "$OUT/$pkgbase" || return 1
  find "$OUT/$pkgbase" -maxdepth 1 -type f -name '*.pkg.tar.zst' -delete || return 1
  : > "$recorded"
  while IFS= read -r f; do
    cp -f "$f" "$OUT/$pkgbase/" || return 1
    sha256sum "$OUT/$pkgbase/$(basename "$f")" >> "$recorded" || return 1
  done <<<"$files"
}

recipe_fingerprint() {
  local pkgdir=$1 listing digest
  [ -f "$pkgdir/PKGBUILD" ] || return 1
  listing=$(mktemp) || return 1
  # Relative paths, and no sync control files: moving a recipe or touching
  # arch.ref/url.override/hold/arch.name must not change its fingerprint.
  if ! (cd "$pkgdir" && find . -mindepth 1 -type d \( -name .git -o -name src -o -name pkg \) -prune -o \
      \( -type f -o -type l \) ! -path ./arch.ref ! -path ./arch.name ! -path ./url.override ! -path ./hold \
      -print0) > "$listing"; then
    rm -f "$listing"
    return 1
  fi
  digest=$(cd "$pkgdir" && sort -z "$listing" | xargs -0 -r sha256sum | sha256sum | cut -d ' ' -f1)
  local rc=$?
  rm -f "$listing"
  [ "$rc" -eq 0 ] || return 1
  printf '%s\n' "$digest"
}

build_fingerprint() {
  local pkgbase=$1 dep ledger_digest=$LEDGER_DIGEST
  printf 'repo: %s\nimage: %s\nconfig: %s\nskip-upgrade: %s\noverwrite: %s\nmemory: %s\nmemory-swap: %s\ncpus: %s\njobs: %s\nbootstrap-policy: %s\nbootstrap-selected: %s\nledger: %s\n' "$REPO" "$IMAGE_ID" "$MAKEPKG_CONF" "${KBUILD_SKIP_UPGRADE:-0}" "${KBUILD_OVERWRITE:-}" "$KBUILD_MEMORY" "$KBUILD_MEMORY_SWAP" "$KBUILD_CPUS" "$KBUILD_JOBS" "$KBUILD_BOOTSTRAP_EDGES" "$BOOTSTRAP_SELECTED" "$ledger_digest"
  sha256sum "$HERE/kbuild-lib.sh" "$HERE/kbuild-inside.sh" "$HERE/kbuild-sched.py" "$HERE/kbuild-arch-bootstrap" "$HERE/conf/$MAKEPKG_CONF" "$HERE"/conf/* || return 1
  recipe_fingerprint "${PKGDIR[$pkgbase]}" || return 1
  for dep in ${GRAPH[$pkgbase]:-}; do
    [ -s "$LOGS/$dep.identity" ] && [ -f "$LOGS/$dep.done" ] || return 1
    sha256sum "$LOGS/$dep.identity" || return 1
    recipe_fingerprint "${PKGDIR[$dep]}" || return 1
  done
}

build_fingerprint_for_build() {
  local pkgbase=$1 dep ledger_digest=$LEDGER_DIGEST
  printf 'repo: %s\nimage: %s\nconfig: %s\nskip-upgrade: %s\noverwrite: %s\nmemory: %s\nmemory-swap: %s\ncpus: %s\njobs: %s\nbootstrap-policy: %s\nbootstrap-selected: %s\nledger: %s\n' "$REPO" "$IMAGE_ID" "$MAKEPKG_CONF" "${KBUILD_SKIP_UPGRADE:-0}" "${KBUILD_OVERWRITE:-}" "$KBUILD_MEMORY" "$KBUILD_MEMORY_SWAP" "$KBUILD_CPUS" "$KBUILD_JOBS" "$KBUILD_BOOTSTRAP_EDGES" "$BOOTSTRAP_SELECTED" "$ledger_digest"
  sha256sum "$HERE/kbuild-lib.sh" "$HERE/kbuild-inside.sh" "$HERE/kbuild-sched.py" "$HERE/kbuild-arch-bootstrap" "$HERE/conf/$MAKEPKG_CONF" "$HERE"/conf/* || return 1
  recipe_fingerprint "${PKGDIR[$pkgbase]}" || return 1
  for dep in ${GRAPH[$pkgbase]:-}; do
    if [ -s "$LOGS/$dep.identity" ] && [ -f "$LOGS/$dep.done" ]; then
      sha256sum "$LOGS/$dep.identity" || return 1
    else
      printf 'unrecorded dependency: %s\n' "$dep"
    fi
    recipe_fingerprint "${PKGDIR[$dep]}" || return 1
  done
}

repo_matches() {
  local file=$1 entry desc entries filename=${1##*/} digest
  cmp -s -- "$file" "$REPO/$filename" || return 1
  digest=$(sha256sum "$file") || return 1
  digest=${digest%% *}
  entries=$(bsdtar -tf "$REPO/kashira.db.tar.gz") || return 1
  while IFS= read -r entry; do
    [[ "$entry" == */desc ]] || continue
    desc=$(bsdtar -xOf "$REPO/kashira.db.tar.gz" "$entry") || return 1
    if awk -v filename="$filename" -v digest="$digest" '
      /^%FILENAME%$/ { getline; name=$0 }
      /^%SHA256SUM%$/ { getline; sum=$0 }
      END { exit !(name == filename && sum == digest) }
    ' <<<"$desc"; then
      return 0
    fi
  done <<<"$entries"
  return 1
}

reusable_artifacts() {
  local pkgbase=$1 record=$LOGS/$1.artifacts file digest fingerprint validated recorded
  [ -f "$LOGS/$pkgbase.done" ] && [ -s "$LOGS/$pkgbase.recipe" ] && [ -s "$LOGS/$pkgbase.identity" ] || return 1
  fingerprint=$(build_fingerprint "$pkgbase") || return 1
  [ "$(<"$LOGS/$pkgbase.recipe")" = "$fingerprint" ] || return 1
  [ -s "$record" ] || return 1
  [ "$(sha256sum "$LOGS/$pkgbase.recipe" "$record" | sha256sum | cut -d ' ' -f1)" = "$(<"$LOGS/$pkgbase.identity")" ] || return 1
  validated=$(artifact_list "$OUT/$pkgbase" "${PKGDIR[$pkgbase]}" "$pkgbase") || return 1
  recorded=$(awk '{print $2}' "$record" | sort) || return 1
  [ "$(printf '%s\n' "$validated" | sort)" = "$recorded" ] || return 1
  while read -r digest file; do
    [ -n "$digest" ] && [ -n "$file" ] && [ -s "$file" ] || return 1
    [[ "$file" == "$OUT/$pkgbase/"*.pkg.tar.zst ]] || return 1
    [ "$(sha256sum "$file")" = "$digest  $file" ] || return 1
    repo_matches "$file" || return 1
    printf '%s\n' "$file"
  done < "$record"
}

build_package() {
  local pkgbase=$1 pkgdir=${PKGDIR[$1]} log="$RUN_DIR/$1.log" fingerprint current
  if ! mixed_repo && [ "$FORCE_REBUILD" != 1 ] && [ -f "$LOGS/$pkgbase.done" ] && reusable_artifacts "$pkgbase" >/dev/null; then
    printf '%s\n' skipped > "$RUN_DIR/$pkgbase.status"
    return 0
  fi
  rm -f "$LOGS/$pkgbase.done"
  if fingerprint=$(build_fingerprint_for_build "$pkgbase") \
      && rm -rf "${RUN_OUT:?}/$pkgbase" \
      && build_one "$pkgbase" "$pkgdir" "$RUN_OUT/$pkgbase" >"$log" 2>&1 \
      && artifact_list "$RUN_OUT/$pkgbase" "$pkgdir" "$pkgbase" >/dev/null \
      && current=$(build_fingerprint_for_build "$pkgbase") \
      && [ "$current" = "$fingerprint" ] \
      && { ! mixed_repo || { for f in "$RUN_OUT/$pkgbase"/*.pkg.tar.zst; do "$HERE/kbuild-arch-bootstrap" record "$REPO" "$f" || return 1; done; }; } \
      && repo_add "$RUN_OUT/$pkgbase" "$pkgdir" "$pkgbase" \
      && { record_build "$pkgbase"; true; } \
      && { mixed_repo || copy_canonical "$pkgbase" "$pkgdir" "$RUN_OUT/$pkgbase"; } \
      && { ! mixed_repo || { cp "$RUN_OUT/$pkgbase/.installed-packages" "$RUN_DIR/$pkgbase.installed-packages" && cp "$RUN_OUT/$pkgbase/.origin-snapshot" "$RUN_DIR/$pkgbase.origin-snapshot" && : > "$LOGS/$pkgbase.artifacts" && for f in "$RUN_OUT/$pkgbase"/*.pkg.tar.zst; do sha256sum "$f" >> "$LOGS/$pkgbase.artifacts"; done; }; } \
      && fingerprint=$(build_fingerprint_for_build "$pkgbase") \
      && printf '%s\n' "$fingerprint" > "$LOGS/$pkgbase.recipe" \
      && sha256sum "$LOGS/$pkgbase.recipe" "$LOGS/$pkgbase.artifacts" | sha256sum | cut -d ' ' -f1 > "$LOGS/$pkgbase.identity" \
      && touch "$LOGS/$pkgbase.done"; then
    rm -f "$LOGS/$pkgbase.failed"
    printf '%s\n' built > "$RUN_DIR/$pkgbase.status"
    return 0
  fi
  if [ -n "${current:-}" ] && [ "$current" != "$fingerprint" ]; then
    echo "recipe or dependency changed during build: $pkgbase" >&2
  fi
  cp -f "$log" "$LOGS/$pkgbase.log" 2>/dev/null || true
  printf '%s\n' failed > "$RUN_DIR/$pkgbase.status"
  printf 'FAILED %s\n' "$pkgbase" > "$LOGS/$pkgbase.failed"
  return 1
}

build_level() {
  local -a pkgs=("$@") pids=()
  local p pid rc=0
  for p in "${pkgs[@]}"; do
    [ -n "$p" ] || continue
    while [ "$(jobs -rp | wc -l)" -ge "$WORKERS" ]; do sleep 2; done
    ( build_package "$p" ) &
    pids+=($!)
  done
  for pid in "${pids[@]}"; do
    wait "$pid" || rc=1
  done
  return $rc
}

# record_build <pkgbase>: store ABI facts of the just-built packages and append their impact to the run report.
record_build() {
  local m=$RUN_DIR/$1.manifest f
  for f in "$RUN_OUT/$1"/*.pkg.tar.*; do printf 'artifact\t%s\t%s\n' "$1" "$f"; done > "$m"
  python3 "$HERE/../kashira-pkgs/tools/kplan/kplan.py" record "$m" --report "$m.impact" \
    && cat "$m.impact" >> "$RUN_DIR/impact.tsv" \
    || echo "warning: build record not stored for $1" >&2
}

append_candidates() {
  local p f files status
  for p in "${targets[@]}"; do
    printf 'target\t%s\n' "$p" >> "$MANIFEST" || return 1
    status=$(cat "$RUN_DIR/$p.status" 2>/dev/null) || return 1
    case "$status" in
      skipped) files=$(reusable_artifacts "$p") || return 1 ;;
      built) files=$(artifact_list "$RUN_OUT/$p" "${PKGDIR[$p]}" "$p") || return 1 ;;
      *) return 1 ;;
    esac
    while IFS= read -r f; do
      printf 'artifact\t%s\t%s\n' "$p" "$(realpath "$f")" >> "$MANIFEST" || return 1
    done <<<"$files"
  done
}

capture_targets() {
  local mode=$1 listfile=${2:-} data line
  case "$mode" in
    all)
      data=$(sched graph) || return 1
      while IFS= read -r line; do
        [ -n "$line" ] || continue
        targets+=("${line%%:*}")
      done <<<"$data"
      ;;
    file)
      [ -f "$listfile" ] || { echo "no such target list: $listfile" >&2; return 1; }
      while IFS= read -r line || [ -n "$line" ]; do
        line=${line%%#*}
        line=${line#"${line%%[![:space:]]*}"}
        line=${line%"${line##*[![:space:]]}"}
        [ -n "$line" ] || continue
        p=$(resolve_target "$line") || return 1
        targets+=("$p")
      done < "$listfile"
      ;;
    dirty)
      shift
      data=$(sched dirty "$@") || return 1
      while IFS= read -r line; do
        [ -n "$line" ] || continue
        p=${line%%[[:space:]]*}
        targets+=("$p")
      done <<<"$data"
      ;;
  esac
}

dedupe_targets() {
  local -A seen=() out=() p
  for p in "${targets[@]}"; do
    p=$(resolve_target "$p") || return 1
    [ -n "${seen[$p]+set}" ] || { seen[$p]=1; out[${#out[@]}]=$p; }
  done
  targets=()
  for p in "${out[@]}"; do targets+=("$p"); done
}

cmd_run() {
  local -a targets=() levels=() pkgs=()
  local data lvl p li=0 nlvl rc=0 no_publish=0 FORCE_REBUILD=0 IMAGE_ID MAKEPKG_CONF BOOTSTRAP_SELECTED='' LEDGER_DIGEST=none
  if [ "${1:-}" = --no-publish ]; then
    no_publish=1
    shift
  fi
  build_repo_guard || return 1
  if mixed_repo; then
    [ "$no_publish" -eq 1 ] || { echo "mixed repository is build-only; --no-publish required" >&2; return 1; }
    mixed_path_ok "$LOGS" "run logs" || return 1
  fi
  mkdir -p "$LOGS" "$OUT" || return 1
  exec 8>"$LOGS/.kbuild-run.lock" 9>"$OUT/.kbuild-run.lock" || return 1
  flock 8 && flock 9 || return 1
  if mixed_repo && [ -f "$HERE/logs/arch-bootstrap-ledger.tsv" ]; then
    LEDGER_DIGEST=$(sha256sum "$HERE/logs/arch-bootstrap-ledger.tsv" | cut -d ' ' -f1)
  fi
  mkdir_run || { echo "cannot create run directory: $RUN_DIR" >&2; return 1; }
  printf '%s\n' "$LEDGER_DIGEST" > "$RUN_DIR/ledger.sha256"
  load_pkgdirs || { run_status failed; return 1; }
  if [ "${1:-}" = --all ]; then
    capture_targets all || { run_status failed; return 1; }
  elif [ "${1:-}" = --file ]; then
    [ $# -eq 2 ] || { echo "--file requires a list" >&2; run_status failed; return 2; }
    capture_targets file "$2" || { run_status failed; return 1; }
  else
    [ $# -gt 0 ] && [[ "$1" != --* ]] || { echo "missing or invalid targets" >&2; run_status failed; return 2; }
    FORCE_REBUILD=1
    capture_targets dirty "$@" || { run_status failed; return 1; }
  fi
  dedupe_targets || { run_status failed; return 1; }
  [ ${#targets[@]} -gt 0 ] || { echo "nothing to build"; run_status prepared; return 0; }
  MAKEPKG_CONF=${KBUILD_MAKEPKG_CONF:-makepkg.conf}
  if [[ "$MAKEPKG_CONF" == */* || "$MAKEPKG_CONF" == . || "$MAKEPKG_CONF" == .. ]] || [ ! -f "$HERE/conf/$MAKEPKG_CONF" ]; then
    echo "invalid KBUILD_MAKEPKG_CONF: $MAKEPKG_CONF" >&2
    run_status failed
    return 2
  fi
  data=$(sched preflight --repo "$REPO" "${targets[@]}") || { run_status failed; return 1; }
  BOOTSTRAP_SELECTED=$(printf '%s\n' "$data" | sort)
  KBUILD_BOOTSTRAP_DEMOTED=$(sched demoted "${targets[@]}" 2>/dev/null) || { run_status failed; return 1; }
  export KBUILD_BOOTSTRAP_DEMOTED
  IMAGE_ID=$(sudo docker image inspect --format '{{.Id}}' "$IMAGE") || { run_status failed; return 1; }
  [ -n "$IMAGE_ID" ] || { run_status failed; return 1; }
  if ! {
    printf 'kbuild-manifest-v1\n'
    printf 'requested\t%s\n' "${targets[@]}"
  } > "$MANIFEST" || ! printf '%s\n' "${targets[@]}" > "$RUN_DIR/targets"; then
    run_status failed
    return 1
  fi
  echo "== run: $RUN_ID"
  echo "== plan: ${#targets[@]} pkgbases"
  for p in "${targets[@]}"; do
    rm -f "$LOGS/$p.failed"
  done
  data=$(sched graph) || { run_status failed; return 1; }
  local -A GRAPH=()
  while IFS= read -r lvl; do
    [ -n "$lvl" ] || continue
    GRAPH[${lvl%%:*}]=${lvl#*: }
  done <<<"$data"
  data=$(sched levels "${targets[@]}") || { run_status failed; return 1; }
  while IFS= read -r lvl; do
    [ -n "$lvl" ] || continue
    levels+=("$lvl")
  done <<<"$data"
  nlvl=${#levels[@]}
  local -A scheduled=() wanted=()
  for p in "${targets[@]}"; do wanted[$p]=1; done
  for lvl in "${levels[@]}"; do
    read -ra pkgs <<<"$lvl"
    for p in "${pkgs[@]}"; do
      if [ -z "${wanted[$p]+set}" ] || [ -n "${scheduled[$p]+set}" ]; then
        echo "invalid scheduler level target: $p" >&2
        run_status failed
        return 1
      fi
      scheduled[$p]=1
    done
  done
  if [ ${#scheduled[@]} -ne ${#targets[@]} ]; then
    echo "scheduler omitted requested targets" >&2
    run_status failed
    return 1
  fi
  for lvl in "${levels[@]}"; do
    li=$((li + 1))
    read -ra pkgs <<<"$lvl"
    echo "== level $li/$nlvl: ${pkgs[*]}"
    build_level "${pkgs[@]}" || rc=1
  done
  if [ "$rc" -ne 0 ]; then
    echo "== build failed; test publication skipped"
    run_status failed
    return 1
  fi
  append_candidates || { echo "invalid or missing run artifact" >&2; run_status failed; return 1; }
  [ -s "$MANIFEST" ] || { echo "run produced no artifacts" >&2; run_status failed; return 1; }
  if [ "$no_publish" -eq 1 ]; then
    echo "== build complete (${#targets[@]} pkgbases); prepared: $MANIFEST"
    run_status prepared
    return 0
  fi
  echo "== build complete (${#targets[@]} pkgbases); publishing to test prefix"
  "$HERE/kbuild-publish" test --manifest "$MANIFEST" || { run_status failed; return 1; }
  run_status published
  return 0
}

case "${1:-}" in
  run) shift; cmd_run "$@"; exit $? ;;
  *) echo "usage: kbuild-run run [--all|--file <list>|<pkgbase...>]" >&2; exit 2 ;;
esac
