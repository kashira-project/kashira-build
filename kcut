#!/usr/bin/env python3
"""kcut — drop named dependency entries from PKGBUILDs as persistent deltas.

The GNOME closure pulls optional-plugin and documentation/test build
dependencies we deliberately do not ship (gnome-roadmap.md section 6 and
Appendix B already call for cutting them). Editing those by hand across dozens
of recipes is where mistakes creep in, so this applies a declarative cut list
and regenerates each delta with diff(1), exactly like kdelta does for one file.

  kcut apply cuts.txt     apply every "pkgbase<TAB>dep[,dep...]" line
  kcut check cuts.txt     report what would change, without writing
  kcut verify [pkgbase ...] check named recipes, or all recipes when omitted

A line looks like:

    gstreamer    qt5-base qt5-declarative qt5-tools qt5-wayland qt5-x11extras

Only makedepends and checkdepends are touched by default; depends is opt-in per
line with a "!" prefix on the dep, because dropping a runtime dep changes the
package contract and must be deliberate.

checkdepends are safe to drop globally: makepkg.conf sets !check, so they are
never installed during a bootstrap build.
"""
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
ROOT = os.path.join(os.path.dirname(HERE), "kashira-arch")
FIELDS = ("makedepends", "checkdepends", "optdepends", "depends")


def field_block(text, field):
    """Return (start, end) span of a field's parenthesised array."""
    m = re.search(r"^" + field + r"=\(", text, re.M)
    if not m:
        return None
    i = text.index("(", m.start())
    depth = 0
    for j in range(i, len(text)):
        if text[j] == "(":
            depth += 1
        elif text[j] == ")":
            depth -= 1
            if depth == 0:
                return (i, j + 1)
    return None


def drop_dep(text, field, dep):
    """Remove one list item from a parenthesised array field.

    Handles every layout an Arch PKGBUILD uses: the dep alone on its own line,
    quoted inline ('dep' 'other'), and as the last entry before the closing
    paren (dep)).
    """
    span = field_block(text, field)
    if not span:
        return text, False
    i, j = span
    block = text[i:j]
    d = re.escape(dep)
    # dep sharing the line with the array opening: makedepends=(chrpath
    block, n = re.subn(r"(\b\w+=\()[ \t]*(?:'" + d + r"'|\"" + d + r"\"|" + d + r")[ \t]*", r"\1", block, count=1)
    if n:
        block = re.sub(r"^[ \t]*\n", "", block, flags=re.M)
        return text[:i] + block + text[j:], True
    # whole-line form: optional indent, optional quotes, then end of line
    block, n = re.subn(r"^[ \t]*(?:'" + d + r"'|\"" + d + r"\"|" + d + r")[ \t]*\n", "", block, flags=re.M)
    if not n:
        # inline form: the dep as a token inside a quoted/bare list, optionally
        # carrying the closing paren of the array.
        block, n = re.subn(r"[ \t]*(?:'" + d + r"'|\"" + d + r"\")(?=[ \t\)]|$)[ \t]*", "", block)
        if not n:
            block, n = re.subn(r"(?<![\w.-])" + d + r"(?=\)|,|$)[ \t]*", "", block)
    if n:
        # tidy the leftovers: collapse runs of spaces, drop blank lines
        block = re.sub(r"[ \t]{2,}(?=\S)", " ", block)
        block = re.sub(r"^[ \t]*\n", "", block, flags=re.M)
        return text[:i] + block + text[j:], True
    return text, False


def apply_pkg(base, deps, dry):
    p = os.path.join(ROOT, "pkgs", base, "PKGBUILD")
    if not os.path.isfile(p):
        print(f"  !! {base}: no PKGBUILD")
        return None
    orig = open(p).read()
    text = orig
    changed = []
    for spec in deps:
        runtime = spec.startswith("!")
        dep = spec[1:] if runtime else spec
        fields = ("depends",) if runtime else ("makedepends", "checkdepends", "optdepends")
        for f in fields:
            text, hit = drop_dep(text, f, dep)
            if hit:
                changed.append(f"{f}:{dep}")
    if text == orig:
        print(f"  = {base}: nothing to cut")
        return False
    if dry:
        print(f"  ~ {base}: would cut {changed}")
        return True
    tmp = f"/tmp/kcut-{base}.new"
    open(tmp, "w").write(text)
    r = subprocess.run(
        ["python3", os.path.join(HERE, "kdelta"), base,
         "--patch", "auto", tmp],
        capture_output=True, text=True)
    if r.returncode != 0:
        print(f"  !! {base}: kdelta FAILED (exit {r.returncode})")
        print((r.stderr or r.stdout)[-1500:])
        return None
    print(f"  + {base}: cut {changed}")
    return True


def verify_parse(base):
    """Confirm the materialized recipe still produces valid .SRCINFO.

    Dropping a split package is only safe if its name leaves the pkgname array
    AND its package_*() function disappears; leaving either behind produces a
    recipe makepkg silently refuses. This catches that before the next wave
    wastes a build cycle on it.
    """
    import shutil
    import tempfile
    src = os.path.join(ROOT, "pkgs", base)
    if not os.path.isfile(os.path.join(src, "PKGBUILD")):
        print(f"  !! {base}: no PKGBUILD")
        return False
    d = tempfile.mkdtemp(prefix="kcut-verify-", dir=os.path.join(os.environ.get("KASHIRA_ROOT", "/mnt/kashira"), "scratch"))
    try:
        shutil.copytree(src, d, dirs_exist_ok=True)
        env = dict(os.environ)
        env.update({k: d for k in ("BUILDDIR", "PKGDEST", "SRCDEST", "SRCPKGDEST", "LOGDEST")})
        r = subprocess.run(["makepkg", "--printsrcinfo"], cwd=d,
                           capture_output=True, text=True, env=env)
        if r.returncode != 0:
            tail = (r.stderr or r.stdout).strip().splitlines()
            print(f"  !! {base} no longer produces .SRCINFO: {tail[-1] if tail else '?'}")
            return False
        return True
    finally:
        shutil.rmtree(d, ignore_errors=True)


def main():
    args = sys.argv[1:]
    if not args or args[0] not in ("apply", "check", "verify"):
        print(__doc__)
        return 2
    mode = args[0]
    if mode == "verify":
        if len(args) == 1:
            bases = sorted(
                d for d in os.listdir(os.path.join(ROOT, "pkgs"))
                if os.path.isfile(os.path.join(ROOT, "pkgs", d, "PKGBUILD")))
        elif len(args) >= 2:
            bases = args[1:]
        else:
            print(__doc__)
            return 2
        bad = [b for b in bases if not verify_parse(b)]
        print(f"verified {len(bases) - len(bad)}/{len(bases)} recipes parse")
        return 1 if bad else 0
    if len(args) != 2:
        print(__doc__)
        return 2
    cutfile = args[1]
    dry = mode == "check"
    n = 0
    failed = []
    touched = []
    for line in open(cutfile):
        line = line.split("#")[0].strip()
        if not line:
            continue
        parts = line.split()
        base, deps = parts[0], parts[1:]
        result = apply_pkg(base, deps, dry)
        if result is True:
            n += 1
            touched.append(base)
        elif result is None:
            failed.append(base)
    print(f"\n{'would change' if dry else 'changed'} {n} pkgbases")
    if failed:
        print(f"failed: {', '.join(failed)}")
        return 1
    if touched and not dry:
        bad = [b for b in touched if not verify_parse(b)]
        if bad:
            print(f"post-apply verification FAILED for: {', '.join(bad)}")
            return 1
        print(f"post-apply .SRCINFO verification: {len(touched)}/{len(touched)} parse")
    return 0


if __name__ == "__main__":
    sys.exit(main())