#!/bin/sh
set -eu

passwd -l root
rm -f /etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf
ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf

pacman_conf=/etc/pacman.conf
grep -Fx '[kashira-v3]' "$pacman_conf" >/dev/null
grep -Fx 'SigLevel = Required DatabaseRequired' "$pacman_conf" >/dev/null
grep -Fx 'Server = https://repo.kashiraproject.org/x86_64-v3' "$pacman_conf" >/dev/null
if grep -Eq '^\[kashira\]$|^Server = file:///var/cache/pacman/kashira$|^SigLevel = Never$' "$pacman_conf"; then
    echo 'headless: refusing unsigned local runtime pacman repository configuration' >&2
    exit 1
fi

systemctl --root=/ preset-all
