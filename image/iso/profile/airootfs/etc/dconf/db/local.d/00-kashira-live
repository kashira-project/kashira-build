# Live medium only: never lock or blank the session, so resume from suspend
# lands on the desktop instead of a password prompt the password-less live user cannot answer.
[org/gnome/desktop/screensaver]
lock-enabled=false
idle-activation-enabled=false

[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/desktop/lockdown]
disable-lock-screen=true

# The installer first in the dash, so it can be reopened after its window is closed. kashira-live (shipped by
# kashira-installer >= 1.0) skips the start-up overview; GNOME ignores an id that is not installed.
[org/gnome/shell]
enabled-extensions=['kashira-live@kashiraproject.org']
disable-extension-version-validation=true
favorite-apps=['org.kashiraproject.Installer.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Console.desktop', 'org.gnome.TextEditor.desktop']
