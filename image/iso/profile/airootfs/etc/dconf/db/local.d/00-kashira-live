# Live medium only: never lock or blank the session, so resume from suspend
# lands on the desktop instead of a password prompt the password-less live user cannot answer.
[org/gnome/desktop/screensaver]
lock-enabled=false
idle-activation-enabled=false

[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/desktop/lockdown]
disable-lock-screen=true

# The installer first in the dash, so it can be reopened after its window is closed.
[org/gnome/shell]
favorite-apps=['org.kashiraproject.Installer.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Console.desktop', 'org.gnome.TextEditor.desktop']
