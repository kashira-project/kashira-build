[Unit]
Description=Give the Kashira live user an empty password (unlock/sudo accept it, as on Ubuntu's live medium)
After=systemd-sysusers.service
Before=display-manager.service systemd-user-sessions.service

[Service]
Type=oneshot
# sysusers creates the account locked ("!*"); pam_unix nullok only accepts a truly empty password.
ExecStart=/usr/bin/passwd -d kashira

[Install]
WantedBy=multi-user.target
