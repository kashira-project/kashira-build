prepare() {
  cd gstreamer

  local option
  for option in \
    "libav:meson.options" \
    "libnice:meson.options" \
    "dbghelp:subprojects/gstreamer/meson.options" \
    "qt6d3d11:subprojects/gst-plugins-bad/meson.options" \
    "wasapi:subprojects/gst-plugins-bad/meson.options" \
    "wasapi2:subprojects/gst-plugins-bad/meson.options" \
    "gtk3:subprojects/gst-plugins-good/meson.options" \
    "pulse:subprojects/gst-plugins-good/meson.options" \
    "libcaca:subprojects/gst-plugins-good/meson.options" \
    "gtk3:subprojects/gst-plugins-bad/meson.options" \
    "chromaprint:subprojects/gst-plugins-bad/meson.options" \
    "fluidsynth:subprojects/gst-plugins-bad/meson.options" \
    "openal:subprojects/gst-plugins-bad/meson.options" \
    "openmpt:subprojects/gst-plugins-bad/meson.options" \
    "zbar:subprojects/gst-plugins-bad/meson.options"; do
    grep -q "option('${option%%:*}'," "${option#*:}" || {
      echo "missing pinned Meson option: ${option%%:*} (${option#*:})" >&2
      return 1
    }
  done

  for option in ../*.patch; do
    echo "Applying patch ${option##*/}..."
    git apply -3 < "$option"
  done
}

build() {
  local meson_options=(
    -Dbase=enabled
    -Dgood=enabled
    -Dbad=enabled
    -Dintrospection=enabled
    -Dugly=disabled
    -Ddevtools=disabled
    -Dges=disabled
    -Drtsp_server=disabled
    -Dpython=disabled
    -Dtls=disabled
    -Dlibav=disabled
    -Dlibnice=disabled
    -Dbenchmarks=disabled
    -Dexamples=disabled
    -Dgst-examples=disabled
    -Dtests=disabled
    -Dglib_debug=disabled
    -Dgpl=enabled
    -Dorc-source=system
    -Dpackage-name="Kashira bootstrap GStreamer ${pkgver}-${pkgrel}"
    -Dpackage-origin="https://gstreamer.freedesktop.org/"
    -Dgst-plugins-base:app=enabled
    -Dgst-plugins-base:gl=enabled
    -Dgst-plugins-base:alsa=enabled
    -Dgst-plugins-base:opus=enabled
    -Dgst-plugins-base:theora=enabled
    -Dgst-plugins-base:vorbis=enabled
    -Dgst-plugins-good:gtk3=disabled
    -Dgst-plugins-good:pulse=enabled
    -Dgst-plugins-good:libcaca=disabled
    -Dgst-plugins-bad:gtk3=disabled
    -Dgst-plugins-bad:gl=enabled
    -Dgst-plugins-bad:va=enabled
    -Dgst-plugins-bad:vulkan=enabled
    -Dgst-plugins-bad:wayland=enabled
    -Dgst-plugins-bad:chromaprint=disabled
    -Dgst-plugins-bad:fluidsynth=disabled
    -Dgst-plugins-bad:openal=disabled
    -Dgst-plugins-bad:openmpt=disabled
    -Dgst-plugins-bad:zbar=disabled
  )

  export GI_SCANNER_DISABLE_CACHE=1
  arch-meson-check-wraps gstreamer
  meson setup --prefix /usr --libexecdir lib --sbindir bin \
    --buildtype plain --auto-features auto --wrap-mode nodownload \
    -D b_pie=true -D python.bytecompile=1 \
    gstreamer build "${meson_options[@]}"
  meson compile -C build
}

_require_files() {
  local src
  for src in "$@"; do
    [[ -e $src || -L $src ]] || {
      echo "missing required $pkgname file: $src" >&2
      return 1
    }
  done
}

_install() {
  local pattern src dir
  local -a matches
  for pattern in "${files[@]}"; do
    matches=( $pattern )
    for src in "${matches[@]}"; do
      [[ -e $src || -L $src ]] || continue
      dir="$pkgdir/$(dirname "$src")"
      mkdir -p "$dir"
      mv "$src" "$dir/"
    done
  done
}

package_gstreamer() {
  pkgdesc+=" - core"
  depends=(glib2 glibc libcap libelf libgcc libunwind)
  optdepends=("python: gst-plugins-doc-cache-generator")
  conflicts=('gstreamer-vaapi<=1.26.10-5')
  install=gstreamer.install

  meson install -C build --destdir "$srcdir/root"
  cd root
  local files=(
    usr/include/gstreamer-1.0/gst/{base,check,controller,net,*.h}
    usr/lib/libgst{reamer,base,check,controller,net}-1.0.so*
    usr/lib/pkgconfig/gstreamer{,-base,-check,-controller,-net}-1.0.pc
    usr/lib/girepository-1.0/Gst{,Base,Check,Controller,Net}-1.0.typelib
    usr/share/gir-1.0/Gst{,Base,Check,Controller,Net}-1.0.gir
    usr/lib/gstreamer-1.0/gst-{completion,ptp}-helper
    usr/lib/gstreamer-1.0/gst-{hotdoc-plugins,plugin}-scanner
    usr/lib/gstreamer-1.0/gst-plugins-doc-cache-generator
    usr/lib/gstreamer-1.0/libgstcoreelements.so
    usr/lib/gstreamer-1.0/libgstcoretracers.so
    usr/share/locale/*/LC_MESSAGES/gstreamer-1.0.mo
    usr/bin/gst-{inspect,launch,stats,tester,typefind}-1.0
    usr/share/man/man1/gst-{inspect,launch,stats,typefind}-1.0.1
    usr/share/bash-completion/completions/gst-{inspect,launch}-1.0
    usr/share/bash-completion/helpers/gst
    usr/share/gdb/auto-load/usr/lib/libgstreamer-1.0.so*.py
    usr/share/gstreamer-1.0/gdb/{glib_gobject_helper.py,gst_gdb.py}
    usr/share/aclocal/gst-element-check-1.0.m4
    usr/share/cmake/FindGStreamer.cmake
  )
  _require_files \
    usr/include/gstreamer-1.0/gst/gst.h \
    usr/lib/libgstreamer-1.0.so \
    usr/lib/pkgconfig/gstreamer-1.0.pc \
    usr/lib/girepository-1.0/Gst-1.0.typelib \
    usr/share/gir-1.0/Gst-1.0.gir \
    usr/lib/gstreamer-1.0/libgstcoreelements.so \
    usr/bin/gst-launch-1.0 || return
  _install
}

