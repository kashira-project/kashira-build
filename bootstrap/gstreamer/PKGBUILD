package_gst-plugins-base() {
  pkgdesc+=" - base plugins"
  depends=("gst-plugins-base-libs=$pkgver-$pkgrel" "gstreamer=$pkgver-$pkgrel" alsa-lib cairo cdparanoia glib2 glibc libgcc libogg libtheora libvorbis opus pango)

  cd root
  local files=(
    usr/lib/gstreamer-1.0/libgst{adder,alsa,app,audioconvert,audiomixer,audiorate,audioresample,audiotestsrc,basedebug,cdparanoia,compositor,dsd,encoding,gio,ogg,opengl,opus,overlaycomposition,pango,pbtypes,playback,rawparse,subparse,tcp,theora,typefindfunctions,videoconvertscale,videorate,videotestsrc,vorbis,volume,ximagesink,xvimagesink}.so
  )
  _require_files \
    usr/lib/gstreamer-1.0/libgstalsa.so \
    usr/lib/gstreamer-1.0/libgstapp.so \
    usr/lib/gstreamer-1.0/libgstaudioconvert.so \
    usr/lib/gstreamer-1.0/libgstogg.so \
    usr/lib/gstreamer-1.0/libgstopus.so \
    usr/lib/gstreamer-1.0/libgstpango.so \
    usr/lib/gstreamer-1.0/libgsttheora.so \
    usr/lib/gstreamer-1.0/libgstvorbis.so || return
  _install
}

