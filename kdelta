#!/usr/bin/env python3
"""kdelta — edit a kashira-arch PKGBUILD as a persistent delta, safely.

Hand-written unified diffs keep landing with wrong hunk line counts, which makes
`sync.py materialize` fail or, worse, apply only part of the change. This drives
the edit from the real file and generates the patch with diff(1), so the result
always applies cleanly.

  kdelta <pkgbase>            show the current materialized PKGBUILD
  kdelta <pkgbase> --edit     open an interactive-ish edit session (see below)
  kdelta <pkgbase> --patch F  replace delta/<pkgbase>/patches/F with a patch that
                              turns upstream/<pkgbase>/PKGBUILD into F

The --patch flow is the one to use from a script:

  cp kashira-arch/pkgs/<pkg>/PKGBUILD /tmp/new
  <edit /tmp/new however you like>
  kdelta <pkg> --patch 0001-cut-optional-plugins.patch /tmp/new

Then it materializes and prints the result.
"""
import os
import re
import subprocess
import sys

ROOT = "/mnt/lfs/src/kashira-arch"


def sh(*cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def pkgdir(base):
    return os.path.join(ROOT, "pkgs", base)


def upstream(base):
    return os.path.join(ROOT, "upstream", base, "PKGBUILD")


def show(base):
    p = os.path.join(pkgdir(base), "PKGBUILD")
    if not os.path.isfile(p):
        sys.exit(f"kdelta: no PKGBUILD for {base}")
    sys.stdout.write(open(p).read())


def make_patch(base, name, newfile):
    # Diff against the CURRENT MATERIALIZED PKGBUILD, not upstream: deltas are
    # replayed in order (upstream + 0001 + 0002 ...), so patch N must be the
    # delta from the state the previous patches produce. Diffing against
    # upstream makes every patch after the first one conflict.
    cur = os.path.join(ROOT, "pkgs", base, "PKGBUILD")
    if not os.path.isfile(cur):
        sys.exit(f"kdelta: no materialized PKGBUILD for {base}")
    r = sh("diff", "-u", "--label", "a/PKGBUILD", "--label", "b/PKGBUILD", cur, newfile)
    if r.returncode not in (0, 1):
        sys.exit(f"kdelta: diff failed: {r.stderr}")
    if not r.stdout.strip():
        sys.exit("kdelta: proposed file is identical to the current recipe; nothing to delta")
    d = os.path.join(ROOT, "delta", base, "patches")
    os.makedirs(d, exist_ok=True)
    if name == "auto":
        # Next free slot AFTER every existing patch number. Patches are replayed
        # in filename order, so reusing 0001 would let this one run before an
        # existing 0001 and then conflict on its context.
        n = 1
        for f in os.listdir(d):
            m = re.match(r"^(\d+)-", f)
            if m:
                n = max(n, int(m.group(1)) + 1)
        name = f"{n:04d}-cut-optional-build-deps.patch"
    dest = os.path.join(d, name)
    open(dest, "w").write(r.stdout)
    print(f"wrote {dest} ({len(r.stdout.splitlines())} lines)")
    return dest


def materialize(base):
    r = sh("python3", "tools/sync.py", "materialize", base, cwd=ROOT)
    sys.stdout.write(r.stdout)
    sys.stderr.write(r.stderr)
    if r.returncode != 0:
        sys.exit(f"kdelta: materialize failed for {base}")
    m = os.path.join(pkgdir(base), "PKGBUILD")
    print(f"--- materialized {m} ---")
    sys.stdout.write(open(m).read())


def main():
    args = sys.argv[1:]
    if not args:
        print(__doc__)
        return 2
    base = args[0]
    if len(args) == 1:
        show(base)
        return 0
    if args[1] == "--patch" and len(args) == 4:
        make_patch(base, args[2], args[3])
        materialize(base)
        return 0
    if args[1] == "--materialize":
        materialize(base)
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main())